---
// A small pixel-art T-Rex mascot fixed in the corner that greets visitors.
// Animation lives in the page script (index.astro) via [data-greeter].
---

{/* No aria-hidden on the wrapper: it holds two real buttons, and a focusable
    control inside an aria-hidden subtree is a dead end for screen readers.
    The decorative parts are hidden individually instead. */}
<div class="greeter" data-greeter>
	<div class="bubble" data-bubble aria-hidden="true">Hi, I'm Boss</div>

	<button class="trex" type="button" aria-label="Poke Boss the dinosaur">
	<svg viewBox="0 0 48 48" width="88" height="88" shape-rendering="crispEdges" aria-hidden="true">
		<!-- Hand-drawn pixel companion, seated behind his laptop. -->
		<path class="pet-shadow" d="M8 45h34v2H8z" />
		<path class="outline" d="M13 29h18v3h3v10h-3v4H12v-3H9V33h4z" />
		<path class="skin" d="M14 30h15v4h3v7h-3v3H13v-3h-2v-7h3z" />
		<path class="belly" d="M16 32h10v8H16z" />
		<path class="pet-shade" d="M12 40h9v4h-8v-2h-1m11-2h7v4h-7z" />
		<path class="skin-light" d="M14 40h5v1h-5m11 0h4v1h-4z" />
		<g class="boss-head">
			<path class="outline" d="M12 2h8V1h6v1h7v2h4v3h3v4h2v10h-2v5h-4v3H12v-2H8v-3H5v-4H3v-8h2V8h3V5h4z" />
			<path class="skin" d="M12 3h8V2h6v1h7v2h4v3h2v4h2v8h-2v5h-4v3H13v-2H9v-3H6v-4H4v-6h2V9h3V6h3z" />
			<path class="skin-light" d="M12 3h8v2h-8M9 6h4v2H9m17-5h7v2h-7m7 2h4v2h-4" />
			<path class="pet-shade" d="M5 19h3v4h4v2h22v-2h4v-3h2v5h-5v3H13v-2H9v-3H6z" />
			<path class="outline" d="M15 12h17v1h3v3h1v8h-2v2H14v-1h-2V15h1v-2h2z" />
			<path class="visor" d="M15 13h17v1h2v2h1v7h-2v2H15v-1h-2v-9h2z" />
			<path class="happy-eyes" d="M17 21v-2h1v-1h3v1h1v2h-1v-1h-3v1zm10 0v-2h1v-1h3v1h1v2h-1v-1h-3v1z" />
			<g class="eye">
				<path class="eye-white" d="M17 20h1v1h3v-1h1v2h-1v1h-3v-1h-1m10-2h1v1h3v-1h1v2h-1v1h-3v-1h-1z" />
			</g>
			<path class="eyelid" d="M17 22h5v1h-5m10-1h5v1h-5z" />
		</g>
		<g class="hand-l">
			<path class="outline" d="M10 29h5v2h3v3h-1v3h-6v-2H9v-4h1z" />
			<path class="skin" d="M11 30h3v2h3v2h-1v2h-4v-2h-2v-3h1z" />
			<path class="skin-light" d="M11 30h3v1h-3z" />
		</g>
		<g class="hand-r">
			<path class="outline" d="M18 32h7v2h2v3H17v-3h1z" />
			<path class="skin" d="M19 33h5v2h2v1h-8v-2h1z" />
		</g>
		<!-- Angled laptop lid and a luminous terminal prompt. -->
		<path class="outline" d="M28 25h19v3l-4 14H23v-2H15v-2h9z" />
		<path class="laptop" d="M29 26h17l-4 14H25z" />
		<path class="laptop-edge" d="M29 26h17v1H29m-5 12h18v1H24m-8-1h8v1h-8z" />
		<g class="code-typing">
			<path class="code" d="M35 30h2v1h1v1h1v2h-1v1h-1v1h-2v-2h1v-2h-1z" />
		</g>
		<path class="code-cursor" d="M38 36h3v1h-3z" />
	</svg>
	</button>

	<svg class="meal-heart" viewBox="0 0 9 8" width="18" height="16" aria-hidden="true" shape-rendering="crispEdges"><path fill="#fff8d9" stroke="#171715" stroke-width="0.5" d="M1 1h2v1h3V1h2v1h1v3H8v1H7v1H6v1H3V7H2V6H1V5H0V2h1z" /></svg>
	<!-- floating zzz while Boss sleeps through the Paynesville night -->
	<div class="zzz" aria-hidden="true"><span>z</span><span>z</span><span>z</span></div>

	<!-- toss Boss a chop — logic lives in index.astro -->
	<button class="feed" data-feed type="button" aria-label="Feed Boss" title="Feed Boss"><svg data-food-art viewBox="0 0 24 24" width="24" height="24" shape-rendering="crispEdges" aria-hidden="true">
			<path fill="#171715" d="M3 2h8v2h3v3h2v6h-2v3h-3v2H6v-2H3v-3H1V6h2zM14 14h3v3h3v-1h3v3h-1v3h-3v-1h-3v-3h-2z" />
			<path fill="#aaa89e" d="M4 3h6v2h3v3h2v4h-2v3h-3v2H6v-2H4v-3H2V7h2z" />
			<path fill="#e8e6dc" d="M4 4h5v2H5v4H3V7h1z" />
			<path fill="#77776e" d="M11 7h2v5h-2v2H7v-2h3V9h1z" />
			<path fill="#fff8d9" d="M15 15h1v2h2v2h2v-2h2v2h-1v2h-2v-1h-2v-2h-2z" />
			<path fill="#55564e" d="M6 7h2v2H6m1 2h2v2H7z" />
		</svg></button>
</div>

<style>
	.greeter {
		position: fixed;
		left: calc(1.25rem + env(safe-area-inset-left));
		bottom: calc(1.25rem + env(safe-area-inset-bottom));
		z-index: 60;
		width: 88px;
		pointer-events: none;
	}

	.trex,
	.bubble,
	.feed {
		pointer-events: auto;
	}

	/* Little round snack button hugging Boss's side. */
	.feed {
		position: absolute;
		left: calc(100% + 4px);
		bottom: 4px;
		width: 1.6rem;
		height: 1.6rem;
		display: grid;
		place-items: center;
		padding: 0;
		font-size: 0.8rem;
		line-height: 1;
		border: 1px solid var(--line);
		border-radius: 50%;
		background: color-mix(in srgb, var(--bg) 70%, transparent);
		-webkit-backdrop-filter: blur(8px);
		backdrop-filter: blur(8px);
		cursor: pointer;
		transition: transform 0.25s ease, border-color 0.25s ease;
	}

	.feed:hover {
		transform: scale(1.15) rotate(-10deg);
		border-color: var(--faint);
	}

	.feed:active {
		transform: scale(0.95);
	}

	/* Boss is a <button> now, so strip the native chrome back to bare SVG. */
	.trex {
		display: block;
		padding: 0;
		border: none;
		background: none;
		font: inherit;
		cursor: pointer;
		filter: drop-shadow(0 4px 8px rgba(0, 0, 0, 0.45));
	}

	.trex svg {
		display: block;
		overflow: visible;
	}

	/* --- Typing. steps(1) rather than a smooth tween: a sprite that eases
	   between positions stops looking like pixel art. The two hands run the
	   same loop half a beat apart, so they alternate. --- */
	@keyframes trex-tap {
		0%,
		49% {
			transform: translateY(0);
		}
		50%,
		100% {
			transform: translateY(1px);
		}
	}

	.hand-l,
	.hand-r {
		animation: trex-tap 0.5s steps(1, end) infinite;
	}

	.hand-r {
		animation-delay: 0.25s;
	}

	/* Every so often he glances up from the screen. */
	@keyframes trex-bob {
		0%,
		78% {
			transform: translateY(0);
		}
		80%,
		100% {
			transform: translateY(-1px);
		}
	}

	.boss-head {
		animation: trex-bob 3.4s steps(1, end) infinite;
	}

	/* Nobody types in their sleep. */
	.greeter.sleeping .hand-l,
	.greeter.sleeping .hand-r,
	.greeter.sleeping .boss-head,
	.greeter.sleeping .screen {
		animation: none;
	}

	/* --- Sleeping mode: closed eye + floating zzz at night --- */
	.eyelid {
		display: none;
		fill: var(--bg);
	}
	.trex.sleeping .eye {
		display: none;
	}
	.trex.sleeping .eyelid {
		display: block;
	}

	.zzz {
		position: absolute;
		top: -4px;
		left: 24px;
		width: 0;
		height: 0;
		pointer-events: none;
		display: none;
	}
	.greeter.sleeping .zzz {
		display: block;
	}
	.zzz span {
		position: absolute;
		left: 0;
		bottom: 0;
		font-weight: 700;
		font-style: italic;
		color: var(--muted);
		opacity: 0;
		animation: zzz-float 3s ease-in-out infinite;
	}
	.zzz span:nth-child(1) {
		font-size: 0.7rem;
		animation-delay: 0s;
	}
	.zzz span:nth-child(2) {
		font-size: 0.9rem;
		animation-delay: 1s;
	}
	.zzz span:nth-child(3) {
		font-size: 1.15rem;
		animation-delay: 2s;
	}

	@keyframes zzz-float {
		0% {
			transform: translate(0, 0) rotate(-8deg);
			opacity: 0;
		}
		25% {
			opacity: 0.85;
		}
		100% {
			transform: translate(16px, -30px) rotate(10deg);
			opacity: 0;
		}
	}

	/* Angry mode — repeated clicks turn Boss into an apex predator. */
	.trex.angry .belly,
	.trex.angry .spike {
		fill: var(--text);
	}

	.bubble {
		position: absolute;
		bottom: calc(100% + 12px);
		left: -8px;
		max-width: 190px;
		line-height: 1.3;
		background: var(--text);
		color: var(--bg);
		font-size: 0.85rem;
		font-weight: 600;
		letter-spacing: -0.01em;
		padding: 0.45rem 0.75rem;
		border-radius: 12px;
		box-shadow: 0 10px 24px -10px rgba(0, 0, 0, 0.6);
		transition: background 0.4s ease, color 0.4s ease;
	}

	/* Bubble matches the mood when angry. */
	.greeter.angry .bubble {
		background: #d83a2c;
		color: #fff;
	}
	.greeter.angry .bubble::after {
		background: #d83a2c;
	}

	.bubble::after {
		content: '';
		position: absolute;
		bottom: -4px;
		left: 20px;
		width: 10px;
		height: 10px;
		background: var(--text);
		border-radius: 2px;
		transform: rotate(45deg);
	}

	/* Hidden until GSAP reveals — only when we can animate (no flash).
	   :not(.anim-bailout) matters: without it, a page where GSAP never loads
	   leaves Boss invisible for good, because nothing is left to reveal him.
	   Layout.astro sets that class after 3s for exactly this case. */
	html.js:not(.reduce-motion):not(.anim-bailout) .trex,
	html.js:not(.reduce-motion):not(.anim-bailout) .bubble,
	html.js:not(.reduce-motion):not(.anim-bailout) .feed {
		opacity: 0;
	}

	@media (max-width: 560px) {
		.greeter {
			left: calc(0.85rem + env(safe-area-inset-left));
			bottom: calc(0.85rem + env(safe-area-inset-bottom));
			width: 64px;
		}
		.trex svg {
			width: 64px;
			height: auto;
		}
		.feed {
			width: 1.4rem;
			height: 1.4rem;
			font-size: 0.7rem;
		}
	}

	/* Fixed character colours preserve the reference in either page theme. */
	.greeter {
		--boss-ink: #171715;
		--boss-body: #e8e6dc;
		--boss-shade: #aaa89e;
		--boss-light: #fffdf3;
		--boss-accent: #fff8d9;
	}
	.outline { fill: var(--boss-ink); }
	.skin { fill: var(--boss-body); }
	.belly, .pet-shade, .spike { fill: var(--boss-shade); }
	.skin-light { fill: var(--boss-light); }
	.visor { fill: #151612; }
	.laptop { fill: #55564e; }
	.laptop-edge { fill: #d3d1c4; }
	.eye-white, .eyelid, .code, .code-cursor { fill: var(--boss-accent); }
	.pet-shadow { fill: #171715; opacity: 0.15; }
	.trex { filter: drop-shadow(0 3px 2px rgba(0, 0, 0, 0.18)); }
	.trex.angry .belly, .trex.angry .spike { fill: var(--boss-body); }
	.code-cursor { animation: boss-cursor 1s steps(1) infinite; }
	.code-typing { animation: boss-terminal 2.8s steps(1) infinite; }
	.eye { transform-box: fill-box; transform-origin: center; animation: boss-blink 5.2s steps(1) infinite; }
	@keyframes boss-terminal {
		0%, 85%, 100% { opacity: 1; }
		90% { opacity: 0.45; }
	}
	@keyframes boss-blink {
		0%, 92%, 97%, 100% { transform: scaleY(1); }
		94%, 96% { transform: scaleY(0.25); }
	}
	@keyframes boss-cursor { 50% { opacity: 0; } }
	@keyframes boss-code {
		0%, 15% { clip-path: inset(0 100% 0 0); }
		30% { clip-path: inset(0 65% 0 0); }
		50% { clip-path: inset(0 30% 0 0); }
		70%, 100% { clip-path: inset(0); }
	}
	@keyframes boss-tail {
		0%, 74%, 100% { transform: translateY(0); }
		78%, 90% { transform: translateY(-1px); }
	}
	.greeter.sleeping .boss-tail,
	.greeter.sleeping .eye,
	.greeter.sleeping .code-typing,
	.greeter.sleeping .code-cursor { animation: none; }
	.greeter.sleeping .code-typing { opacity: 0; }
	.greeter.sleeping .code-muted { opacity: 0.3; }
	.trex:focus-visible, .feed:focus-visible {
		outline: 2px solid var(--text);
		outline-offset: 5px;
		border-radius: 4px;
	}
	@media (prefers-reduced-motion: reduce) {
		.greeter *, .greeter *::after { animation: none !important; transition: none !important; }
	}

	.feed { width: 36px; height: 36px; border-radius: 8px; }
	.feed svg { display: block; width: 26px; height: 26px; }
	.feed:disabled { cursor: default; }
	.happy-eyes { display: none; fill: var(--boss-accent); }
	.greeter.eating .eye, .greeter.happy .eye { display: none; }
	.greeter.eating .happy-eyes, .greeter.happy .happy-eyes { display: block; }
	.greeter.eating .hand-l, .greeter.eating .hand-r,
	.greeter.eating .boss-head, .greeter.eating .code-typing,
	.greeter.eating .code-cursor { animation-play-state: paused; }
	.meal-heart { position: absolute; left: 36px; top: -14px; opacity: 0; pointer-events: none; }
	.greeter.happy .meal-heart { opacity: 1; animation: meal-love 1.4s ease-out both; }
	@keyframes meal-love { from { transform: translateY(5px); } to { transform: translateY(-12px); opacity: 0; } }
	@media (max-width: 560px) { .feed { width: 32px; height: 32px; } .feed svg { width: 24px; height: 24px; } }
</style>
