---
// Intro: name, "updated" date, and three short paragraphs with inline links.
// TODO(Abraham): replace the GitHub and LinkedIn "#" placeholders with your real URLs.
const email = 'abrahamasheriff6@gmail.com';
const portfolio = 'https://abesboss.netlify.app';
const github = 'https://github.com/coLeaner';
const linkedin = '#';
const MansaStock = 'https://mansa-stock.vercel.app';
---

<header class="intro">
	<h1 class="name" data-anim="fade">Abraham A. Sheriff</h1>
	<p class="updated" data-anim="fade">
		<span class="time" data-clock aria-label="Current local time in Paynesville">—:—:—</span>
	</p>

	<div class="body">
		<p data-anim="lines">
			Hi, and welcome. I'm a web developer based in Paynesville City, Liberia,
			and I create simple, user-friendly digital experiences that help businesses
			stay focused on what matters most.
		</p>
		<p data-anim="lines">
			I am currently completing my BSc in Information Technology at <span
				class="hl">BlueCrest University College</span>, and my work are usually associated with <span class="brushlink">
			UX/UI, HTML, CSS, JavaScript, React,
		</span>
			<span class="brushlink brush-gh"> and Next.js </span>
			 Right now, I am building <br/>
			<span class="brushlink"><a href={MansaStock}>MansaStock</a> </span> The AI business management application, that help businesses run their entire business operations with ease,
			and I also handle data-related
			work at MAS Pharmacy.
		</p>
		<p class="say-hi" data-anim="fade">
			Say hello on{' '}
			<a class="brushlink brush-gh" href={github} target="_blank" rel="noopener" data-magnetic="0.3">GitHub</a>,{' '}
			<a class="brushlink brush-li" href={linkedin} target="_blank" rel="noopener" data-magnetic="0.3">LinkedIn</a>, my{' '}
			<a class="brushlink brush-pf" href={portfolio} target="_blank" rel="noopener" data-magnetic="0.3">portfolio</a>, or{' '}
			<a id="copy-email" class="brushlink brush-em" href={`mailto:${email}`} data-email={email} aria-label="Copy email address" data-magnetic="0.3"><span class="label">email</span></a>{' '}
			let’s chat.
		</p>
	</div>
</header>

<style>
	.intro {
		padding-top: clamp(4rem, 12vh, 8rem);
	}

	.name {
		margin: 0;
		font-size: clamp(1.125rem, 1rem + 0.6vw, 1.375rem);
		font-weight: 500;
		letter-spacing: -0.02em;
	}

	.updated {
		margin: 0.25rem 0 0;
		color: var(--muted);
		font-size: 0.9375rem;
	}

	.updated .time {
		color: var(--text);
		font-variant-numeric: tabular-nums;
	}

	/* Blinking colons give the ticking clock a little pulse. */
	.updated .time :global(.c) {
		animation: clock-blink 1s ease-in-out infinite;
	}

	@keyframes clock-blink {
		0%,
		100% {
			opacity: 1;
		}
		50% {
			opacity: 0.25;
		}
	}

	.body {
		margin-top: clamp(3rem, 8vh, 5rem);
		display: flex;
		flex-direction: column;
		gap: 1.4em;
		max-width: 34rem;
	}

	.body p {
		margin: 0;
	}

	.hl {
		color: var(--text);
	}

	.body a {
		text-decoration: underline;
		text-decoration-color: var(--faint);
		text-underline-offset: 3px;
		transition: text-decoration-color 0.25s ease;
	}

	.body a:hover {
		text-decoration-color: var(--text);
	}

	/* Paint-brush links: a brush stroke sweeps in behind the text on hover.
	   --paint (0 → 1) is driven by GSAP; CSS is the reduced-motion fallback. */
	.brushlink {
		--paint: 1;
		--brush: var(--accent);
		position: relative;
		display: inline-block;
		isolation: isolate;
	}

	/* Each link keeps its own brush colour. */
	.brush-gh {
		--brush: #a371f7;
	}
	.brush-li {
		--brush: #2f80ed;
	}
	.brush-pf {
		--brush: #f5a623;
	}
	.brush-em {
		--brush: #10b981;
	}

	.brushlink::before {
		content: '';
		position: absolute;
		left: -0.18em;
		right: -0.18em;
		bottom: -0.05em;
		height: 0.62em;
		z-index: -1;
		background: var(--brush);
		opacity: 0.9;
		-webkit-mask: url('/brush.svg') no-repeat center / 100% 100%;
		mask: url('/brush.svg') no-repeat center / 100% 100%;
		transform: scaleX(var(--paint));
		transform-origin: left center;
		pointer-events: none;
	}

	/* Copy-email link: clip the label so it can slide vertically on copy. */
	#copy-email {
		display: inline-flex;
		overflow: hidden;
		vertical-align: bottom;
		line-height: 1.65;
	}

	#copy-email .label {
		display: inline-block;
		will-change: transform, opacity;
	}
	.hl {
		color: rgb(9, 9, 214);
		font-weight: 500;
		font-size: 1.1rem;
		font-bold: 500;
	}
</style>
