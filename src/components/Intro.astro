---
// Profile header — avatar, name, role, then the bio as plain prose with the
// links woven into the sentences. The old grid of social icon tiles is gone:
// at this size a name and three underlined words say the same thing quieter.
// TODO(Abraham): swap the LinkedIn "#" placeholder for your real profile URL.
import { Image } from 'astro:assets';
import avatar from '../assets/photos/profile.jpg';
import PhotoPreview from './PhotoPreview.astro';
import mansaLightLogo from '../assets/logos/mansastock-light.webp';
import mansaDarkLogo from '../assets/logos/mansastock-dark.webp';

const email = 'abrahamasheriff6@gmail.com';
const github = 'https://github.com/coLeaner';
const linkedin = '#';
const mansaStock = 'https://mansa-stock.vercel.app';
---

<header class="intro">
	<div class="who" data-anim="fade">
		{/* The avatar paints at 56px (3.5rem). widths cover 1x through 3x of
		    that, because stopping at 128 left a DPR-3 phone upscaling a 2x
		    file — the same thing that was softening the photo row. */}
		<Image
			class="avatar"
			src={avatar}
			alt="Abraham A. Sheriff"
			width={224}
			widths={[56, 112, 168, 224]}
			sizes="56px"
			quality={90}
			loading="eager"
		/>
		<div class="lines">
			<h1 class="name">
				Abraham A. Sheriff
				<svg class="check" viewBox="0 0 24 24" aria-label="Verified" role="img">
					<path
						class="seal"
						d="m22.25 12-2.3-2.6.32-3.44-3.4-.77L15.09 2 12 3.36 8.91 2 7.13 5.19l-3.4.77.32 3.44L1.75 12l2.3 2.6-.32 3.44 3.4.77L8.91 22 12 20.64 15.09 22l1.78-3.19 3.4-.77-.32-3.44Z"
					></path>
					<path class="mark" d="M8.2 12.2l2.6 2.6 5-5.4"></path>
				</svg>
			</h1>
			<p class="role">Web Developer · Paynesville, Liberia</p>
		</div>
	</div>

	{/* Build → study → community → contact. The Work section below lists the
	    same roles with logos, links and dates, so the bio stays short and
	    says what the list can't: that community service is a real part of
	    the picture, not a footnote under the code.

	    The MansaStock link and the Rotaract span keep their
	    data-photo-preview hooks: they are the only two triggers the
	    PhotoPreview component has, and cutting them would leave it rendering
	    stacks nothing can open. */}
	<div class="body">
		<p data-anim="lines">
			I'm a web developer building simple, user-friendly digital experiences.
			Right now that means <a class="contact-link" href={mansaStock} data-photo-preview="mansa" target="_blank" rel="noopener"
				><span>MansaStock</span><img class="contact-icon" data-mansa-logo data-light-src={mansaLightLogo.src} data-dark-src={mansaDarkLogo.src} src={mansaDarkLogo.src} alt="" width="16" height="16" /></a
			>, an AI business management app.
		</p>
		<p data-anim="lines">
			I'm also finishing a BSc in Information Technology at BlueCrest
			University College.
		</p>
		<p data-anim="lines">
			Outside tech, a lot of my time goes to community service: Charter
			President of the{' '}
			<span class="preview-trigger organization" tabindex="0" data-photo-preview="rotaract">Rotaract Club of Congo Town</span>{' '}
			and a volunteer with{' '}
			<a class="organization" href="https://liberia.empowermentsquared.org/" target="_blank" rel="noopener noreferrer">Empowerment Squared Liberia</a>.
		</p>
		<p data-anim="lines">
			Reach me by <a class="contact-link" href={`mailto:${email}`}><span>email</span><svg class="contact-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="3" y="5" width="18" height="14" rx="2" /><path d="m3 6 9 7 9-7" /></svg></a>{
				linkedin !== '#' && (
					<>
						{' or on '}
						<a href={linkedin} target="_blank" rel="noopener">
							LinkedIn
						</a>
					</>
				)
			}, or see my code on{' '}
			{/* SplitText re-wraps this paragraph into one div per measured line,
			    and it treated the link and the full stop as separate units —
			    leaving a lone "." stranded on its own line. nowrap keeps them
			    on the same line whichever way the text breaks. */}
			<span class="no-break"><a class="contact-link" href={github} target="_blank" rel="noopener"><span>GitHub</span><svg class="contact-icon" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M12 .75a11.25 11.25 0 0 0-3.56 21.92c.56.1.77-.24.77-.54v-2.1c-3.13.68-3.79-1.33-3.79-1.33-.51-1.3-1.25-1.65-1.25-1.65-1.02-.7.08-.69.08-.69 1.13.08 1.72 1.16 1.72 1.16 1 1.72 2.63 1.22 3.27.93.1-.73.39-1.22.71-1.5-2.5-.28-5.13-1.25-5.13-5.56 0-1.23.44-2.23 1.16-3.02-.12-.28-.5-1.43.11-2.98 0 0 .95-.3 3.1 1.15a10.8 10.8 0 0 1 5.63 0c2.15-1.46 3.1-1.15 3.1-1.15.61 1.55.23 2.7.11 2.98.72.79 1.16 1.8 1.16 3.02 0 4.32-2.63 5.27-5.14 5.55.4.35.76 1.03.76 2.08v3.1c0 .3.2.65.77.54A11.25 11.25 0 0 0 12 .75Z" /></svg></a>.</span>
		</p>
	</div>
</header>

<PhotoPreview />

<script>
	const logo = document.querySelector<HTMLImageElement>('[data-mansa-logo]');
	const systemTheme = matchMedia('(prefers-color-scheme: light)');
	function syncMansaLogo() {
		if (!logo) return;
		const theme = document.documentElement.dataset.theme;
		const light = theme ? theme === 'light' : systemTheme.matches;
		const src = light ? logo.dataset.lightSrc : logo.dataset.darkSrc;
		if (src) logo.setAttribute('src', src);
	}
	syncMansaLogo();
	new MutationObserver(syncMansaLogo).observe(document.documentElement, {
		attributes: true,
		attributeFilter: ['data-theme'],
	});
	systemTheme.addEventListener('change', syncMansaLogo);
</script>

<style>
	.intro {
		padding-top: clamp(2.5rem, 8vh, 4.5rem);
	}

	.who {
		display: flex;
		align-items: center;
		gap: 0.9rem;
	}

	.avatar {
		flex: none;
		width: 3.5rem;
		height: 3.5rem;
		border-radius: 50%;
		object-fit: cover;
		border: 1px solid var(--line);
	}

	.lines {
		min-width: 0;
	}

	.name {
		font-family: var(--font-display);
		margin: 0;
		display: flex;
		align-items: center;
		gap: 0.35rem;
		font-size: clamp(1.0625rem, 1rem + 0.5vw, 1.25rem);
		font-weight: 600;
		letter-spacing: -0.02em;
	}

	/* Scalloped seal + tick, drawn rather than imported so it inherits the
	   accent and needs no extra request. */
	.check {
		display: block;
		width: 1em;
		height: 1em;
		flex: none;
	}

	.check .seal {
		fill: var(--accent);
	}

	.check .mark {
		fill: none;
		stroke: var(--bg);
		stroke-width: 2.2;
		stroke-linecap: round;
		stroke-linejoin: round;
	}

	.role {
		margin: 0.1rem 0 0;
		color: var(--muted);
		font-size: 0.9375rem;
	}

	.body {
		margin-top: clamp(1.75rem, 5vh, 2.5rem);
		display: flex;
		flex-direction: column;
		gap: 1.1em;
	}

	.body p {
		margin: 0;
	}

	.no-break {
		white-space: nowrap;
	}

	.contact-link {
		display: inline-flex;
		align-items: center;
		gap: 0.3em;
		white-space: nowrap;
		vertical-align: baseline;
	}

	.contact-icon {
		width: 0.9em;
		height: 0.9em;
		flex: none;
		align-self: center;
	}

	.body a {
		color: inherit;
		font-weight: 500;
		text-decoration: underline;
		text-decoration-thickness: 1px;
		text-decoration-color: var(--faint);
		text-underline-offset: 4px;
		transition: text-decoration-color 0.25s ease, color 0.25s ease;
	}

	.body a:focus-visible, .preview-trigger:focus-visible {
		outline: 2px solid var(--accent);
		outline-offset: 4px;
		border-radius: 2px;
	}

	.body a:hover {
		color: var(--accent);
		text-decoration-color: var(--accent);
	}

	.body .organization {
		text-decoration: none;
		font-weight: inherit;
	}
</style>
