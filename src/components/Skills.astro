---
// Toolkit — the technical stack and the working traits, kept apart. Mixing
// "React" and "Communication" into one undifferentiated run made the
// technical list read as padded.
const groups = [
	{
		label: 'Tech',
		items: ['UX/UI', 'HTML', 'CSS', 'JavaScript', 'React', 'Next.js'],
	},
	{
		label: 'Strengths',
		items: ['Problem-solving', 'Creativity', 'Communication', 'Time management'],
	},
];
---

<section class="skills">
	<h2 class="heading" data-anim="fade">Toolkit</h2>

	{
		groups.map((group) => (
			<div class="row">
				<h3 class="label">{group.label}</h3>
				<ul class="grid">
					{group.items.map((s) => (
						<li class="card" data-card data-anim="cards">
							<span class="name">{s}</span>
						</li>
					))}
				</ul>
			</div>
		))
	}
</section>

<style>
	.skills {
		margin-top: clamp(4rem, 11vh, 7rem);
	}

	/* Same divider + weight as every other section heading. */
	.heading {
		margin: 0 0 1.35rem;
		font-size: 1.0625rem;
		font-weight: 600;
		letter-spacing: -0.015em;
		color: var(--text);
	}

	/* Label column matches Work's year column, so the two sections share a
	   left edge and the page keeps one rhythm. */
	.row {
		display: grid;
		grid-template-columns: 6rem 1fr;
		gap: 1rem;
		align-items: baseline;
	}

	.row + .row {
		margin-top: 1rem;
	}

	.label {
		margin: 0;
		font-size: 0.9375rem;
		font-weight: 400;
		color: var(--faint);
	}

	/* Just the words — a wrapping row, no boxes. */
	.grid {
		list-style: none;
		margin: 0;
		padding: 0;
		display: flex;
		flex-wrap: wrap;
		gap: 0.6rem 1.5rem;
	}

	.card {
		display: inline-flex;
		cursor: default;
	}

	.name {
		font-size: 1rem;
		font-weight: 500;
		letter-spacing: -0.01em;
		color: var(--muted);
		white-space: nowrap;
		transition: color 0.3s ease;
	}

	/* Brighten toward --text, not --accent. Accent is the link colour here, and
	   these words aren't links. */
	.card:hover .name {
		color: var(--text);
	}

	/* Same breakpoint as Work: the label stops being a column and sits above. */
	@media (max-width: 640px) {
		.row {
			grid-template-columns: 1fr;
			gap: 0.4rem;
		}

		.row + .row {
			margin-top: 1.5rem;
		}
	}
</style>
