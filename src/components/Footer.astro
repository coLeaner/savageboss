---
// Footer: live local time on the left, a link to this page's own source on
// the right, with the visitor counter sitting above the rule.
import VisitorCount from './VisitorCount.astro';

const source =
	'https://github.com/coLeaner/savageboss/blob/master/src/pages/index.astro';
---

<footer class="footer">
	<div class="wrap">
		<VisitorCount />

		<div class="row">
			<p class="where">
				<span class="time" data-clock>—:—:—</span> in Paynesville, Liberia
			</p>

			{/* The joke is the point, but "steal my code" alone doesn't say where
			    it goes — the title spells that out for anyone hovering, and for
			    a screen reader reaching the end of the page. */}
			<a
				class="source"
				href={source}
				target="_blank"
				rel="noopener"
				title="View this page's source on GitHub"
			>steal my code</a>
		</div>
	</div>
</footer>

<script is:inline>
	// Live local time in Paynesville (Liberia runs on GMT+0, Africa/Monrovia).
	// Lives here rather than beside the photos because the clock moved into
	// the footer — an inline script only sees markup already parsed above it.
	(function () {
		var el = document.querySelector('[data-clock]');
		if (!el) return;
		var fmt = new Intl.DateTimeFormat('en-US', {
			timeZone: 'Africa/Monrovia',
			hour: 'numeric',
			minute: '2-digit',
			second: '2-digit',
			hour12: true,
		});
		function render() {
			var map = {};
			fmt.formatToParts(new Date()).forEach(function (p) {
				map[p.type] = p.value;
			});
			el.innerHTML =
				map.hour +
				'<span class="c">:</span>' +
				map.minute +
				'<span class="c">:</span>' +
				map.second +
				(map.dayPeriod || '').toLowerCase();
		}
		render();
		setInterval(render, 1000);
	})();
</script>

<style>
	.footer {
		padding-bottom: calc(clamp(2rem, 6vh, 3.5rem) + env(safe-area-inset-bottom));
	}

	.wrap {
		max-width: var(--content);
		margin: 0 auto;
	}

	.row {
		display: flex;
		align-items: baseline;
		justify-content: space-between;
		gap: 1rem;
		font-size: 0.9375rem;
		color: var(--muted);
	}

	.where {
		margin: 0;
	}

	.time {
		color: var(--text);
		font-variant-numeric: tabular-nums;
	}

	/* Blinking colons give the ticking clock a little pulse. */
	.time :global(.c) {
		animation: clock-blink 1s ease-in-out infinite;
	}

	@keyframes clock-blink {
		0%,
		100% {
			opacity: 1;
		}
		50% {
			opacity: 0.25;
		}
	}

	.source {
		color: var(--muted);
		text-decoration: underline;
		text-decoration-thickness: 1px;
		text-decoration-color: var(--faint);
		text-underline-offset: 4px;
		transition: color 0.25s ease, text-decoration-color 0.25s ease;
	}

	.source:hover {
		color: var(--text);
		text-decoration-color: var(--text);
	}
</style>
