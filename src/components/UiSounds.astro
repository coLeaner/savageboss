---
// Site-wide UI sound effects, synthesized live with the Web Audio API — no
// audio files to load. Soft ticks when hovering links/text/images, a click on
// press, and eating noises for Boss (played via window.bossAudio from the
// page script). The speaker button under the theme toggle mutes everything.
---

<button
	id="sound-toggle"
	type="button"
	data-magnetic="0.4"
	aria-label="Toggle sound effects"
	title="Toggle sound"
>
	<svg class="i-on" viewBox="0 0 24 24" aria-hidden="true">
		<path d="M11 5 6 9H2v6h4l5 4z"></path>
		<path d="M15.5 8.5a5 5 0 0 1 0 7"></path>
		<path d="M18.5 5.5a9 9 0 0 1 0 13"></path>
	</svg>
	<svg class="i-off" viewBox="0 0 24 24" aria-hidden="true">
		<path d="M11 5 6 9H2v6h4l5 4z"></path>
		<path d="M16 9l6 6M22 9l-6 6"></path>
	</svg>
</button>

<script is:inline>
	(function () {
		var muted = false;
		try {
			muted = localStorage.getItem('sound') === 'off';
		} catch (e) {}

		var ctx = null;
		var master = null;

		function ensureCtx() {
			if (muted) return;
			if (!ctx) {
				var AC = window.AudioContext || window.webkitAudioContext;
				if (!AC) return;
				ctx = new AC();
				master = ctx.createGain();
				master.gain.value = 0.9;
				master.connect(ctx.destination);
			}
			if (ctx.state === 'suspended') ctx.resume();
		}

		// Browsers keep audio locked until a real gesture — unlock on the first one.
		['pointerdown', 'keydown', 'touchstart'].forEach(function (ev) {
			window.addEventListener(ev, ensureCtx, { once: true, passive: true });
		});

		// One short enveloped oscillator = one UI blip.
		function blip(freq, endFreq, dur, type, vol, delay) {
			var t = ctx.currentTime + (delay || 0);
			var o = ctx.createOscillator();
			var g = ctx.createGain();
			o.type = type;
			o.frequency.setValueAtTime(freq, t);
			if (endFreq) o.frequency.exponentialRampToValueAtTime(endFreq, t + dur);
			g.gain.setValueAtTime(vol, t);
			g.gain.exponentialRampToValueAtTime(0.0001, t + dur);
			o.connect(g);
			g.connect(master);
			o.start(t);
			o.stop(t + dur + 0.03);
		}

		// Short filtered noise burst — the "crunch" body of a chomp.
		function crunch(dur, cutoff, vol, delay) {
			var t = ctx.currentTime + (delay || 0);
			var n = Math.floor(ctx.sampleRate * dur);
			var buf = ctx.createBuffer(1, n, ctx.sampleRate);
			var d = buf.getChannelData(0);
			for (var i = 0; i < n; i++) d[i] = (Math.random() * 2 - 1) * (1 - i / n);
			var src = ctx.createBufferSource();
			src.buffer = buf;
			var f = ctx.createBiquadFilter();
			f.type = 'lowpass';
			f.frequency.value = cutoff;
			var g = ctx.createGain();
			g.gain.value = vol;
			src.connect(f);
			f.connect(g);
			g.connect(master);
			src.start(t);
		}

		var fx = {
			hover: function () { blip(2400, 1900, 0.05, 'sine', 0.05); }, // plain text
			hover2: function () { blip(1500, 900, 0.07, 'triangle', 0.1); }, // links/images
			click: function () {
				blip(1200, 700, 0.06, 'square', 0.07);
				blip(300, 130, 0.09, 'sine', 0.16, 0.012);
			},
			pop: function () { blip(420, 900, 0.08, 'sine', 0.16); },
			chomp: function () {
				crunch(0.09, 750, 0.55);
				blip(200, 65, 0.12, 'sine', 0.34);
			},
			gulp: function () { blip(320, 90, 0.2, 'sine', 0.22, 0.02); },
			burp: function () {
				blip(150, 55, 0.3, 'sawtooth', 0.16);
				crunch(0.2, 300, 0.25, 0.03);
			},
			shatter: function () {
				crunch(0.22, 5000, 0.5); // glassy crack
				blip(2600, 300, 0.3, 'triangle', 0.16, 0.02);
				blip(3200, 500, 0.25, 'sine', 0.1, 0.06);
				blip(1800, 240, 0.35, 'sine', 0.09, 0.1);
			},
		};

		function play(name) {
			if (muted || !ctx) return;
			if (ctx.state !== 'running') {
				ctx.resume();
				return;
			}
			var f = fx[name];
			if (f) f();
		}

		// Page scripts (Boss's feeding, etc.) trigger sounds through this.
		window.bossAudio = { play: play };

		// --- Hover ticks: brighter for interactive things, softer for plain text ---
		var INTERACTIVE =
			'a, button, [role="option"], img, [data-polaroid], .gb-note, .card, .trex, input';
		var TEXTY = 'h1, h2, h3, h4, p, li, dt, dd, blockquote, label';
		var lastEl = null;
		var lastAt = 0;

		if (window.matchMedia('(hover: hover)').matches) {
			document.addEventListener(
				'mouseover',
				function (e) {
					var t = e.target;
					if (!(t instanceof Element)) return;
					var el = t.closest(INTERACTIVE);
					var kind = 'hover2';
					if (!el) {
						el = t.closest(TEXTY);
						kind = 'hover';
					}
					if (!el) {
						lastEl = null; // left everything — next entry may tick again
						return;
					}
					if (el === lastEl) return;
					lastEl = el;
					var now = performance.now();
					if (now - lastAt < 65) return; // rate-limit fast mouse sweeps
					lastAt = now;
					play(kind);
				},
				true
			);
		}

		// --- Click sound on anything pressable ---
		document.addEventListener(
			'pointerdown',
			function (e) {
				var t = e.target;
				if (!(t instanceof Element)) return;
				if (t.closest('a, button, [role="option"], .trex, img, [data-polaroid], input, .gb-note')) {
					play('click');
				}
			},
			true
		);

		// --- Mute toggle ---
		var btn = document.getElementById('sound-toggle');
		function sync() {
			btn.classList.toggle('muted', muted);
			btn.setAttribute('aria-pressed', String(!muted));
		}
		if (btn) {
			btn.addEventListener('click', function () {
				muted = !muted;
				try {
					localStorage.setItem('sound', muted ? 'off' : 'on');
				} catch (e) {}
				sync();
				if (!muted) {
					ensureCtx();
					setTimeout(function () { play('pop'); }, 80);
				}
			});
			sync();
		}
	})();
</script>

<style>
	#sound-toggle {
		position: fixed;
		top: calc(clamp(1rem, 3vw, 1.75rem) + 3.25rem);
		right: clamp(1rem, 3vw, 1.75rem);
		z-index: 50;
		width: 2.5rem;
		height: 2.5rem;
		display: grid;
		place-items: center;
		padding: 0;
		border: 1px solid var(--line);
		border-radius: 50%;
		background: color-mix(in srgb, var(--bg) 70%, transparent);
		color: var(--muted);
		cursor: pointer;
		-webkit-backdrop-filter: blur(8px);
		backdrop-filter: blur(8px);
		transition: color 0.25s ease, border-color 0.25s ease, transform 0.25s ease;
	}

	#sound-toggle:hover {
		color: var(--text);
		border-color: var(--faint);
		transform: scale(1.08);
	}

	#sound-toggle svg {
		width: 1.15rem;
		height: 1.15rem;
		fill: none;
		stroke: currentColor;
		stroke-width: 1.7;
		stroke-linecap: round;
		stroke-linejoin: round;
	}

	#sound-toggle .i-off {
		display: none;
	}

	#sound-toggle.muted .i-on {
		display: none;
	}

	#sound-toggle.muted .i-off {
		display: block;
	}

	#sound-toggle.muted {
		color: var(--faint);
	}
</style>
