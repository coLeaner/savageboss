---
// "Elsewhere" — a fanned polaroid row of personal photos.
// Images live in src/assets so Astro resizes and re-encodes them at build time;
// the originals are multi-megabyte phone shots rendered ~150px wide.
// The label shows above each photo on hover.
import { Image } from 'astro:assets';
import cloudOfFluff from '../assets/photos/cloud-of-fluff.jpg';
import legend from '../assets/photos/legend.jpg';
import theGoat from '../assets/photos/the-goat.jpg';
import redDevil from '../assets/photos/red-devil.jpg';
import cowboy from '../assets/photos/cowboy.jpg';
import favMeme from '../assets/photos/fav-meme.jpg';
import minimal from '../assets/photos/minimal.jpg';
import outExploring from '../assets/photos/out-exploring.jpg';

const photos = [
	{ src: cloudOfFluff, label: 'My cloud of fluff' },
	{ src: legend, label: 'Legend' },
	{ src: theGoat, label: 'The GOAT' },
	{ src: redDevil, label: 'Red Devil' },
	{ src: cowboy, label: 'Cowboy era' },
	{ src: favMeme, label: 'Fav meme' },
	{ src: minimal, label: 'Minimal' },
	{ src: outExploring, label: 'Out exploring' },
];

// The card is clamp(7.5rem, 14vw, 10.5rem) wide — up to 168px — and
// clamp(4.75rem, 21vw, 6.5rem) on phones, and hover scales it 1.14, so the
// painted box tops out near 192px.
//
// `sizes` has to describe THAT box. It previously claimed 152px while the
// cards had grown to 168px, so the browser picked a candidate too small for
// the box and upscaled it — which is what made these look soft.
const sizes = '(max-width: 560px) 120px, 192px';
// 1x / 1.5x / 2x / 3x of the 192px box, so a phone at DPR 3 still gets real
// pixels instead of a stretched 2x file.
const widths = [192, 288, 384, 576];
---

<section class="offscreen">
	<div class="wrap">
		<h2 class="heading" data-anim="fade">Elsewhere</h2>
	</div>

	<div class="stage">
		<svg class="flight" viewBox="0 0 800 240" preserveAspectRatio="xMidYMid meet" aria-hidden="true">
			<path
				id="flightPath"
				class="trail"
				fill="none"
				d="M40,150 C140,70 260,70 360,120 C460,170 560,80 680,80 C760,80 780,150 700,170 C580,200 460,120 360,160 C260,200 140,210 60,180 C20,165 20,175 40,150 Z"
			></path>
			<g id="plane" class="plane">
				<path class="wing" d="M-13,-7 L15,0 L-13,7 L-6,0 Z"></path>
				<path class="fold" d="M-6,0 L15,0 L-13,7 Z"></path>
			</g>
		</svg>

		<div class="fan" data-fan>
			{
				photos.map((photo) => (
					<figure class="polaroid" data-polaroid>
						<figcaption class="tip">{photo.label}</figcaption>
						<div class="photo-frame">
						<Image
							src={photo.src}
							alt={photo.label}
							width={576}
							widths={widths}
							sizes={sizes}
							quality={90}
							loading="lazy"
							decoding="async"
						/>
						</div>
					</figure>
				))
			}
		</div>
	</div>
</section>


<style>
	.offscreen {
		margin-top: clamp(4rem, 11vh, 7rem);
		margin-bottom: clamp(3.5rem, 9vh, 6rem);
	}

	.wrap {
		max-width: var(--content);
		margin: 0 auto;
	}

	/* Same divider + weight as Work and Guestbook, so every section opens the
	   same way. */
	.heading {
		margin: 0 0 1.35rem;
		font-size: 1.0625rem;
		font-weight: 600;
		letter-spacing: -0.015em;
		color: var(--text);
	}

	.stage {
		position: relative;
	}

	/* MotionPath flight layer — a paper plane loops over the photos. */
	.flight {
		position: absolute;
		inset: 0;
		width: 100%;
		height: 100%;
		z-index: 3;
		pointer-events: none;
		overflow: visible;
		display: none;
	}

	html.js:not(.reduce-motion) .flight {
		display: block;
	}

	.plane {
		color: var(--accent);
	}
	.plane .wing {
		fill: currentColor;
	}
	.plane .fold {
		fill: currentColor;
		opacity: 0.45;
	}

	.trail {
		fill: none;
		stroke: none;
	}

	/* Never wrap. The fan animation spreads the photos across one arc by index,
	   so a second row would come out as a pile of randomly rotated cards. The
	   negative margins keep all eight inside the gutters down to ~360px. */
	.fan {
		display: flex;
		justify-content: center;
		align-items: flex-start;
		flex-wrap: nowrap;
		gap: 0;
		perspective: 1200px;
	}

	/* GSAP upgrades the flat row into a 40° fan by adding .circled and
	   pivoting each card around a point well below it. Everything stays in
	   normal flow until then, so a no-JS visitor still gets the row. */
	.fan.circled {
		position: relative;
		display: block;
		height: var(--fan-h, 26rem);
	}

	.fan.circled .polaroid {
		position: absolute;
		left: 50%;
		top: 0;
		margin: 0;
		/* GSAP owns the outer transform only for the fan layout. */
		transition: opacity 0.3s ease;
	}

	/* Not a polaroid any more: a dark-bezelled card, the way the reference
	   frames them. The white border and the deep bottom lip were throwing the
	   brightest thing on the page behind the photos themselves. */
	.polaroid {
		position: relative;
		margin: 0 -1.6rem;
		width: clamp(7.5rem, 14vw, 10.5rem);
		transition: opacity 0.3s ease;
		cursor: pointer;
	}

	/* Keep the hover target stationary; scale the frame around its own centre. */
	.photo-frame {
		pointer-events: none;
		transform-origin: center;
		background: var(--card);
		padding: 0.3rem;
		border: 1px solid var(--card-line);
		border-radius: 14px;
		box-shadow: 0 22px 44px -20px var(--polaroid-shadow);
	}

	/* height: auto is load-bearing. Astro's <Image> emits width/height
	   attributes, and that height is a presentational hint — so without this
	   the element height is never `auto` and `aspect-ratio` is ignored, which
	   renders every photo at its raw phone-screenshot proportions. */
	.polaroid img {
		display: block;
		width: 100%;
		height: auto;
		aspect-ratio: 3 / 4;
		object-fit: cover;
		border-radius: 11px;
		/* Grey by default so the row reads as one object; the photo you're
		   actually looking at comes back to life. */
		filter: grayscale(1) contrast(1.04);
		transition: filter 0.5s ease;
	}

	.polaroid:hover img {
		filter: grayscale(0) contrast(1);
	}

	/* Hovered photo straightens, lifts and grows to the front. */
	.fan:not(.circled) .polaroid:hover .photo-frame {
		transform: translateY(-22px) rotate(0deg) scale(1.18) !important;
	}

	.polaroid:hover {
		z-index: 5;
	}

	/* Dim the other photos so the hovered one stands out. */
	.fan:hover .polaroid:not(:hover) {
		opacity: 0.55;
	}

	/* Hover label pill floating above the photo. */
	.tip {
		position: absolute;
		left: 0.3rem;
		bottom: calc(100% + 0.75rem);
		z-index: 6;
		min-height: 1.9em;
		display: inline-flex;
		align-items: center;
		white-space: nowrap;
		background: #ffffff;
		color: #17171a;
		font-size: 0.8125rem;
		font-weight: 600;
		letter-spacing: -0.01em;
		padding: 0.35rem 0.75rem;
		border-radius: 999px;
		box-shadow: 0 10px 24px -10px rgba(0, 0, 0, 0.55);
		opacity: 0;
		pointer-events: none;
	}

	/* No-JS / reduced-motion fallback: reveal the label on hover via CSS. */
	html:not(.js) .polaroid:hover .tip,
	html.reduce-motion .polaroid:hover .tip {
		opacity: 1;
	}

	@media (max-width: 560px) {
		.heading {
			margin-bottom: 1.75rem;
		}

		/* Tighter width + deeper overlap so all 8 fit a phone. */
		.polaroid {
			width: clamp(4.75rem, 21vw, 6.5rem);
			margin: 0 -1.5rem;
		}

		.photo-frame {
			padding: 0.22rem;
			border-radius: 11px;
		}

		.polaroid img {
			border-radius: 9px;
		}

		/* Hover isn't a thing on touch — soften the zoom so a tapped photo
		   doesn't blow past the screen edge. */
		.fan:not(.circled) .polaroid:hover .photo-frame {
			transform: translateY(-14px) rotate(0deg) scale(1.1) !important;
		}

		.tip {
			font-size: 0.75rem;
			padding: 0.3rem 0.6rem;
		}
	}

	/* Very narrow phones: shrink the plane's breathing room isn't needed,
	   but pull the fan in a touch more so it clears the gutters. */
	@media (max-width: 380px) {
		.polaroid {
			margin: 0 -1.7rem;
		}
	}
</style>
