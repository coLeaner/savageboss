---
// "Off screen" — a fanned polaroid row of personal photos.
// Images live in /public and are served from the site root. The label (from the
// file name) shows above each photo on hover. `src` is URL-encoded for spaces.
const photos = [
	{ src: '/Screenshot_20260626_140850_Instagram.jpg', label: 'My cloud of fluff' },
	{ src: '/mydwag!!!.jpg', label: 'My dwag!!!' },
	{ src: '/GOAT.jpg', label: 'The GOAT' },
	{ src: '/Reddevil.jpg', label: 'Red Devil' },
	{ src: '/Where i live.jpg', label: 'Where I live' },
	{ src: '/Fav meme.jpg', label: 'Fav meme' },
	{ src: '/Screenshot_20260630_175044_Instagram.jpg', label: 'Hello from AB 😊' },
	{ src: '/Screenshot_20260524_201442_Instagram(1).jpg', label: 'Out exploring' },
].map((p) => ({ ...p, src: encodeURI(p.src) }));
---

<section class="offscreen">
	<div class="wrap">
		<h2 class="heading" data-anim="fade">Off screen</h2>
	</div>

	<div class="stage">
		<svg class="flight" viewBox="0 0 800 240" preserveAspectRatio="xMidYMid meet" aria-hidden="true">
			<path
				id="flightPath"
				class="trail"
				fill="none"
				d="M40,150 C140,70 260,70 360,120 C460,170 560,80 680,80 C760,80 780,150 700,170 C580,200 460,120 360,160 C260,200 140,210 60,180 C20,165 20,175 40,150 Z"
			></path>
			<g id="plane" class="plane">
				<path class="wing" d="M-13,-7 L15,0 L-13,7 L-6,0 Z"></path>
				<path class="fold" d="M-6,0 L15,0 L-13,7 Z"></path>
			</g>
		</svg>

		<div class="fan" data-fan>
			{
				photos.map((photo) => (
					<figure class="polaroid" data-polaroid>
						<figcaption class="tip">{photo.label}</figcaption>
						<img src={photo.src} alt={photo.label} loading="lazy" />
					</figure>
				))
			}
		</div>
	</div>

	<div class="wrap">
		<p class="caption" data-anim="row">
			<span class="time" data-clock aria-label="Current local time in Paynesville">—:—:—</span> in Paynesville, Liberia
		</p>
	</div>
</section>

<script is:inline>
	// Live local time in Paynesville (Liberia runs on GMT+0, Africa/Monrovia).
	(function () {
		var el = document.querySelector('[data-clock]');
		if (!el) return;
		var fmt = new Intl.DateTimeFormat('en-US', {
			timeZone: 'Africa/Monrovia',
			hour: 'numeric',
			minute: '2-digit',
			second: '2-digit',
			hour12: true,
		});
		function render() {
			var map = {};
			fmt.formatToParts(new Date()).forEach(function (p) {
				map[p.type] = p.value;
			});
			el.innerHTML =
				map.hour +
				'<span class="c">:</span>' +
				map.minute +
				'<span class="c">:</span>' +
				map.second +
				(map.dayPeriod || '').toLowerCase();
		}
		render();
		setInterval(render, 1000);
	})();
</script>

<style>
	.offscreen {
		margin-top: clamp(3.5rem, 9vh, 6rem);
		margin-bottom: clamp(3.5rem, 9vh, 6rem);
	}

	.wrap {
		max-width: var(--content);
		margin: 0 auto;
	}

	.heading {
		margin: 0 0 2.5rem;
		font-size: 0.9375rem;
		font-weight: 400;
		color: var(--muted);
	}

	.stage {
		position: relative;
	}

	/* MotionPath flight layer — a paper plane loops over the photos. */
	.flight {
		position: absolute;
		inset: 0;
		width: 100%;
		height: 100%;
		z-index: 3;
		pointer-events: none;
		overflow: visible;
		display: none;
	}

	html.js:not(.reduce-motion) .flight {
		display: block;
	}

	.plane {
		color: var(--accent);
	}
	.plane .wing {
		fill: currentColor;
	}
	.plane .fold {
		fill: currentColor;
		opacity: 0.45;
	}

	.trail {
		fill: none;
		stroke: none;
	}

	.fan {
		display: flex;
		justify-content: center;
		align-items: flex-start;
		flex-wrap: wrap;
		gap: 0;
		perspective: 1200px;
	}

	.polaroid {
		position: relative;
		margin: 0 -1.75rem;
		background: var(--polaroid-bg);
		padding: 0.45rem 0.45rem 1rem;
		border-radius: 3px;
		box-shadow: 0 16px 34px -16px var(--polaroid-shadow);
		width: clamp(7rem, 13vw, 9.5rem);
		transition: transform 0.45s cubic-bezier(0.22, 1, 0.36, 1), opacity 0.3s ease;
		cursor: pointer;
	}

	.polaroid img {
		width: 100%;
		aspect-ratio: 3 / 4;
		object-fit: cover;
		border-radius: 1px;
	}

	/* Hovered photo straightens, lifts and grows to the front. */
	.polaroid:hover {
		transform: translateY(-22px) rotate(0deg) scale(1.18) !important;
		z-index: 5;
	}

	/* Dim the other photos so the hovered one stands out. */
	.fan:hover .polaroid:not(:hover) {
		opacity: 0.55;
	}

	/* Hover label pill floating above the photo. */
	.tip {
		position: absolute;
		left: 0.3rem;
		bottom: calc(100% + 0.75rem);
		z-index: 6;
		min-height: 1.9em;
		display: inline-flex;
		align-items: center;
		white-space: nowrap;
		background: #ffffff;
		color: #17171a;
		font-size: 0.8125rem;
		font-weight: 600;
		letter-spacing: -0.01em;
		padding: 0.35rem 0.75rem;
		border-radius: 999px;
		box-shadow: 0 10px 24px -10px rgba(0, 0, 0, 0.55);
		opacity: 0;
		pointer-events: none;
	}

	.caption {
		margin: 3rem 0 0;
		color: var(--muted);
		font-size: 0.9375rem;
	}

	.caption .time {
		color: var(--text);
		font-variant-numeric: tabular-nums;
	}

	/* Blinking colons give the ticking clock a little pulse. */
	.caption .time :global(.c) {
		animation: clock-blink 1s ease-in-out infinite;
	}

	@keyframes clock-blink {
		0%,
		100% {
			opacity: 1;
		}
		50% {
			opacity: 0.25;
		}
	}

	/* No-JS / reduced-motion fallback: reveal the label on hover via CSS. */
	html:not(.js) .polaroid:hover .tip,
	html.reduce-motion .polaroid:hover .tip {
		opacity: 1;
	}

	@media (max-width: 560px) {
		.heading {
			margin-bottom: 1.75rem;
		}

		/* Keep all photos on a single arc — never let the fan wrap into
		   two broken rows. Tighter width + deeper overlap so 8 fit a phone. */
		.fan {
			flex-wrap: nowrap;
		}

		.polaroid {
			width: clamp(4.5rem, 20vw, 6rem);
			margin: 0 -1.55rem;
			padding: 0.35rem 0.35rem 0.8rem;
		}

		/* Hover isn't a thing on touch — soften the zoom so a tapped photo
		   doesn't blow past the screen edge. */
		.polaroid:hover {
			transform: translateY(-14px) rotate(0deg) scale(1.1) !important;
		}

		.tip {
			font-size: 0.75rem;
			padding: 0.3rem 0.6rem;
		}

		.caption {
			margin-top: 2.25rem;
		}
	}

	/* Very narrow phones: shrink the plane's breathing room isn't needed,
	   but pull the fan in a touch more so it clears the gutters. */
	@media (max-width: 380px) {
		.polaroid {
			margin: 0 -1.7rem;
		}
	}
</style>
