---
import { products, PLACEHOLDER } from '../data/products';
import type { ImageMetadata } from 'astro';
import rotaractLogo from '../assets/logos/rotaract.png';

type Entry = {
 title: string;
 note: string;
 href?: string;
 tag?: string;
 variant?: string;
 period?: string;
 logo?: ImageMetadata;
 logoDark?: ImageMetadata;
 svg?: string;
 icon?: 'chart' | 'cap';
};
const groups: { label: string; items: Entry[] }[] = [
 { label: 'Projects', items: products },
 { label: 'Experience', items: [
  { title: 'MAS Pharmacy', note: 'Data & inventory operations', tag: 'Data Analytics', variant: 'data', period: '2026', icon: 'chart' },
 ] },
 { label: 'Community', items: [
  { title: 'Rotaract Club of Congo Town', note: 'Charter President', period: '2026', logo: rotaractLogo },
  { title: 'Empowerment Squared Liberia', note: 'Volunteer', href: 'https://liberia.empowermentsquared.org/', period: '2026', svg: '/logos/empowerment-squared.svg' },
 ] },
 { label: 'Education', items: [
  { title: 'BlueCrest University College', note: 'BSc Information Technology', period: '2022 — 26', icon: 'cap' },
 ] },
];
---

<section class="work" aria-labelledby="work-heading">
 <h2 id="work-heading" class="heading" data-anim="fade">Work</h2>
 <ul class="folders">
  {groups.map((group) => (
   <li class="folder-branch">
    <details class="folder" open>
     <summary>
      <svg class="folder-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
       <path class="folder-back" d="M3 18.5V5.8A1.8 1.8 0 0 1 4.8 4h4.1l2.2 2.5h8.1A1.8 1.8 0 0 1 21 8.3v2.2" />
       <path class="folder-front" d="M3 19h15.8a1.5 1.5 0 0 0 1.45-1.1L22 11H7l-2 6.7A1.8 1.8 0 0 1 3 19Z" />
      </svg>
      <h3>{group.label}</h3>
      <span class="folder-count" aria-label={`${group.items.length} ${group.items.length === 1 ? 'item' : 'items'}`}>{group.items.length}</span>
      <svg class="chevron" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><path d="m6 4 4 4-4 4" /></svg>
     </summary>
     <ul class="entries">
      {group.items.map((item) => (
       <li class="entry">
        <div class="entry-main">
         <span class="entry-name">
         {item.href && item.href !== PLACEHOLDER ? (
          <a href={item.href} target="_blank" rel="noopener noreferrer">{item.title}<span class="external" aria-hidden="true">↗</span></a>
         ) : <span class="entry-title">{item.title}</span>}
         {item.logo || item.svg ? (
          <img class="item-icon" src={item.logo?.src || item.svg} data-work-logo={item.logoDark ? '' : undefined} data-light-src={item.logo?.src} data-dark-src={item.logoDark?.src} alt="" width="16" height="16" loading="lazy" />
         ) : (
          <svg class="item-icon line-icon" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
           {item.icon === 'chart' ? <path d="M3 20h18M6 16v-4m6 4V6m6 10V9" /> : <><path d="m2 8 10-5 10 5-10 5L2 8Zm4 2v6c3 3 9 3 12 0v-6M22 8v7" /></>}
          </svg>
         )}
         </span>
         {item.tag && <span class:list={['tag', item.variant]}>{item.variant === 'building' && <span class="status-dot" aria-hidden="true" />}{item.tag}</span>}
        </div>
        <div class="entry-meta">
         <span class="note"><span class="slashes" aria-hidden="true">// </span>{item.note}</span>
         <span class="period">{item.period}</span>
        </div>
       </li>
      ))}
     </ul>
    </details>
   </li>
  ))}
 </ul>
</section>

<script>
 const logos = document.querySelectorAll<HTMLImageElement>('[data-work-logo]');
 const systemTheme = matchMedia('(prefers-color-scheme: light)');
 function syncLogos() {
  const theme = document.documentElement.dataset.theme;
  const light = theme ? theme === 'light' : systemTheme.matches;
  logos.forEach(logo => {
   const src = light ? logo.dataset.lightSrc : logo.dataset.darkSrc;
   if (src) logo.setAttribute('src', src);
  });
 }
 syncLogos();
 new MutationObserver(syncLogos).observe(document.documentElement, { attributes: true, attributeFilter: ['data-theme'] });
 systemTheme.addEventListener('change', syncLogos);
</script>

<style>
 .work { margin-top: clamp(4rem, 11vh, 7rem); }
 .heading { margin: 0 0 1.5rem; font-size: 1.0625rem; font-weight: 600; letter-spacing: -0.015em; }
 .folders, .entries { list-style: none; margin: 0; padding: 0; }
 .folders { --branch-color: var(--line); padding-left: 0.65rem; }
 .folder-branch { position: relative; border-left: 1px solid var(--branch-color); padding: 0 0 1rem 1.5rem; }
 .folder-branch::before { content: ''; position: absolute; top: 1.15rem; left: 0; width: 1.1rem; border-top: 1px solid var(--branch-color); }
 .folder-branch:last-child { border-left-color: transparent; padding-bottom: 0; }
 .folder-branch:last-child::after { content: ''; position: absolute; left: -1px; top: 0; height: 1.15rem; border-left: 1px solid var(--branch-color); }
 summary { display: flex; align-items: center; gap: 0.65rem; width: fit-content; min-height: 2.3rem; padding: 0.15rem 0.35rem; margin-left: -0.35rem; border-radius: 5px; cursor: pointer; list-style: none; color: var(--muted); transition: color 180ms ease, background-color 180ms ease; }
 summary::-webkit-details-marker { display: none; }
 summary:hover { color: var(--accent); background: color-mix(in srgb, var(--accent) 6%, transparent); }
 summary:focus-visible { outline: 2px solid var(--accent); outline-offset: 4px; }
 summary h3 { font-size: 1rem; font-weight: 400; margin: 0; }
 .folder[open] > summary { color: var(--accent); }
 .folder-icon { width: 1.2rem; height: 1.2rem; flex: none; }
 .folder-front { fill: color-mix(in srgb, var(--accent) 8%, var(--bg)); transform-origin: 3px 19px; transition: transform 180ms ease; }
 .folder:not([open]) .folder-front { transform: skewY(-8deg) scaleY(1.15); }
 .folder-count { font-size: 0.6875rem; color: var(--faint); font-variant-numeric: tabular-nums; }
 .chevron { width: 0.8rem; height: 0.8rem; color: var(--faint); transition: transform 180ms ease; }
 .folder[open] .chevron { transform: rotate(90deg); }
 .entries { margin: 0.4rem 0 0.3rem 0.55rem; }
 .entry { position: relative; display: grid; grid-template-columns: minmax(0, 1fr) minmax(10rem, 43%); gap: 0.5rem 1.25rem; padding: 0.7rem 0 0.7rem 1.5rem; border-left: 1px solid var(--branch-color); }
 .entry::before { content: ''; position: absolute; left: 0; top: 1.45rem; width: 0.9rem; border-top: 1px solid var(--branch-color); }
 .entry:last-child { border-left-color: transparent; }
 .entry:last-child::after { content: ''; position: absolute; left: -1px; top: 0; height: 1.45rem; border-left: 1px solid var(--branch-color); }
 .entry-main { display: flex; align-items: baseline; flex-wrap: wrap; gap: 0.4rem 0.55rem; min-width: 0; font-size: 0.9375rem; line-height: 1.65; }
 .entry-name { display: inline-flex; align-items: baseline; gap: 0.4rem; min-width: 0; }
 .item-icon { width: 1rem; height: 1rem; flex: none; align-self: center; object-fit: contain; }
 .line-icon { color: var(--muted); }
 .entry a { color: var(--text); text-decoration: none; transition: color 180ms ease; }
 .entry a:hover, .entry a:focus-visible { color: var(--accent); }
 .entry a:focus-visible { outline-offset: 4px; }
 .external { display: inline-block; margin-left: 0.25rem; font-size: 0.75rem; color: var(--faint); transition: color 180ms ease; }
 .entry a:hover .external { color: var(--accent); }
 .entry-title { color: var(--text); }
 .entry-meta { display: flex; flex-direction: column; align-items: flex-end; justify-content: center; gap: 0.1rem; text-align: right; }
 .note { color: var(--muted); font-size: 0.75rem; line-height: 1.65; }
 .slashes { color: var(--faint); }
 .period { color: var(--faint); font-size: 0.6875rem; font-variant-numeric: tabular-nums; }
 .tag { display: inline-flex; align-items: center; gap: 0.35em; padding: 0.25em 0.45em; border-radius: 4px; font-size: 0.625rem; line-height: 1.4; white-space: nowrap; }
 .tag.building { color: var(--tag-building-fg); background: var(--tag-building-bg); }
 .tag.data { color: var(--tag-data-fg); background: var(--tag-data-bg); }
 .status-dot { width: 0.35em; height: 0.35em; border-radius: 50%; background: currentColor; }
 @media (max-width: 600px) {
  .folder-branch { padding-left: 1.15rem; }
  .folder-branch::before { width: 0.75rem; }
  .entry { grid-template-columns: minmax(0, 1fr); padding-left: 1.1rem; }
  .entry::before { width: 0.65rem; }
  .entry-meta { align-items: flex-start; text-align: left; gap: 0.25rem 0.7rem; flex-direction: row; flex-wrap: wrap; }
  .entry-main { font-size: 0.875rem; }
 }
</style>
