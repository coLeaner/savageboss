---
// Visitor guestbook — leave a short signed note that everyone can see.
// Persists to Supabase (public read + insert, guarded by RLS).
// Notes render as colored sticky notes pinned to the wall; visitors can
// doodle a tiny sketch, stamp a mood emoji, and drag notes around.
const moods = ['😄', '🔥', '❤️', '👋', '😎', '🥲'];
---

<section class="guestbook">
	<div class="wrap">
		<h2 class="heading" data-anim="fade">Guestbook</h2>
		<p class="lead" data-anim="fade">Drop a note — let the world know you were here.</p>

		<form class="gb-form" data-gb-form autocomplete="off">
			<div class="fields">
				<div class="field">
					<input
						class="gb-input gb-name"
						id="gb-name"
						name="name"
						type="text"
						maxlength="40"
						required
						autocomplete="name"
						spellcheck="false"
						placeholder=" "
					/>
					<label class="gb-lbl" for="gb-name">Your name</label>
				</div>
				<div class="field">
					{/* A textarea, not an input: 280 characters in a one-line field
					    means you can't see what you already wrote. */}
					<textarea
						class="gb-input gb-msg"
						id="gb-message"
						name="message"
						maxlength="280"
						rows="2"
						placeholder=" "></textarea>
					<label class="gb-lbl" for="gb-message">Say something</label>
				</div>
				<button class="gb-send" type="submit" data-magnetic="0.35">Sign</button>
			</div>

			<div class="gb-extras">
				<div class="gb-moods" role="group" aria-label="Pick a mood for your note">
					{moods.map((m) => (
						<button type="button" class="gb-mood-btn" data-mood={m} aria-pressed="false">{m}</button>
					))}
				</div>
				<button type="button" class="gb-pad-toggle" data-pad-toggle aria-expanded="false">
					✏️ Doodle
				</button>
			</div>

			<div class="gb-pad" data-pad hidden>
				{/* role="application" so arrow keys reach the canvas instead of
				    being swallowed by a screen reader's browse mode — this is
				    the case that role exists for: a widget with its own
				    keyboard interaction that has no native equivalent. */}
				<div class="gb-canvas-wrap">
					<canvas
						class="gb-canvas"
						data-canvas
						width="360"
						height="252"
						tabindex="0"
						role="application"
						aria-label="Doodle pad — draw a small sketch for your note"
						aria-describedby="gb-pad-hint"></canvas>
					<span class="gb-caret" data-caret aria-hidden="true" hidden></span>
				</div>
				<div class="gb-pad-row">
					<span class="gb-pad-hint" id="gb-pad-hint">
						Drag to draw, or focus the pad and steer with the arrow keys —
						space puts the pen down and lifts it again.
					</span>
					<button type="button" class="gb-pad-clear" data-pad-clear>Clear</button>
				</div>
			</div>

			<p class="gb-status" data-gb-status role="status" aria-live="polite"></p>
		</form>

		{/* Deliberately not a live region: the initial load replaces all 40
		    notes at once, which a screen reader would read out end to end.
		    Submit feedback goes through .gb-status instead. */}
		<ul class="gb-list" data-gb-list></ul>
	</div>
</section>

<script>
	import { gsap } from 'gsap';
	import { ScrollTrigger } from 'gsap/ScrollTrigger';
	import { Draggable } from 'gsap/Draggable';
	import { supabase } from '../lib/supabase';

	const reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
	if (!reduced) gsap.registerPlugin(ScrollTrigger, Draggable);

	// Dragging is desktop-only: on touch it would fight page scrolling.
	const canDrag =
		!reduced && window.matchMedia('(hover: hover) and (pointer: fine)').matches;

	const form = document.querySelector<HTMLFormElement>('[data-gb-form]');
	const list = document.querySelector<HTMLElement>('[data-gb-list]');
	const status = document.querySelector<HTMLElement>('[data-gb-status]');
	const btn = form?.querySelector<HTMLButtonElement>('.gb-send');

	const PAPER_COUNT = 6;
	const DOODLE_RE = /^data:image\/png;base64,[A-Za-z0-9+/=]+$/;

	type Row = {
		name: string;
		message: string;
		created_at: string;
		mood?: string | null;
		doodle?: string | null;
	};

	function say(msg: string, kind: 'ok' | 'err' | '' = '') {
		if (!status) return;
		status.textContent = msg;
		status.dataset.kind = kind;
	}

	// "3h ago"-style relative time, kept tiny and dependency-free.
	function ago(iso: string) {
		const s = Math.max(1, Math.round((Date.now() - new Date(iso).getTime()) / 1000));
		const steps: [number, string][] = [
			[60, 's'], [60, 'm'], [24, 'h'], [7, 'd'], [4.3, 'w'], [12, 'mo'],
		];
		let val = s, unit = 's';
		for (const [size, u] of steps) {
			if (val < size) { unit = u; break; }
			val = Math.round(val / size);
			unit = u;
		}
		return unit === 's' ? 'just now' : `${val}${unit} ago`;
	}

	// Cheap string hash so each note keeps the same paper color and tilt
	// across reloads instead of reshuffling every visit.
	function hash(s: string) {
		let h = 0;
		for (let i = 0; i < s.length; i++) h = (h * 31 + s.charCodeAt(i)) | 0;
		return Math.abs(h);
	}

	// --- Mood picker: one emoji, tap again to unpick ---
	let mood: string | null = null;
	const moodBtns = Array.from(
		document.querySelectorAll<HTMLButtonElement>('.gb-mood-btn')
	);
	moodBtns.forEach((b) => {
		b.addEventListener('click', () => {
			mood = mood === b.dataset.mood ? null : b.dataset.mood ?? null;
			moodBtns.forEach((x) =>
				x.setAttribute('aria-pressed', String(x.dataset.mood === mood))
			);
		});
	});

	// --- Doodle pad: tiny transparent-PNG sketches ---
	const pad = document.querySelector<HTMLElement>('[data-pad]');
	const padToggle = document.querySelector<HTMLButtonElement>('[data-pad-toggle]');
	const padClear = document.querySelector<HTMLButtonElement>('[data-pad-clear]');
	const canvas = document.querySelector<HTMLCanvasElement>('[data-canvas]');
	const ink = canvas?.getContext('2d') ?? null;
	let drawing = false;
	let dirty = false;

	if (ink) {
		ink.strokeStyle = '#2e2820';
		ink.lineWidth = 5; // canvas is 2x its display size
		ink.lineCap = 'round';
		ink.lineJoin = 'round';
	}

	function padPoint(e: PointerEvent) {
		const r = canvas!.getBoundingClientRect();
		return {
			x: ((e.clientX - r.left) / r.width) * canvas!.width,
			y: ((e.clientY - r.top) / r.height) * canvas!.height,
		};
	}

	canvas?.addEventListener('pointerdown', (e) => {
		if (!ink) return;
		canvas.setPointerCapture(e.pointerId);
		drawing = true;
		dirty = true;
		const p = padPoint(e);
		ink.beginPath();
		ink.moveTo(p.x, p.y);
		ink.lineTo(p.x + 0.1, p.y + 0.1); // a tap leaves a dot
		ink.stroke();
	});
	canvas?.addEventListener('pointermove', (e) => {
		if (!drawing || !ink) return;
		const p = padPoint(e);
		ink.lineTo(p.x, p.y);
		ink.stroke();
	});
	['pointerup', 'pointercancel'].forEach((ev) =>
		canvas?.addEventListener(ev, () => (drawing = false))
	);

	// --- Keyboard drawing ---
	// The pad is pointer-first, but without this a keyboard user tabs to the
	// "Doodle" toggle, opens it, and finds a panel with nothing operable in it.
	// Arrows steer the pen (Shift for bigger steps), space puts it down.
	const caret = document.querySelector<HTMLElement>('[data-caret]');
	let penX = canvas ? canvas.width / 2 : 0;
	let penY = canvas ? canvas.height / 2 : 0;
	let penDown = false;

	function drawCaret() {
		if (!caret || !canvas) return;
		caret.style.left = `${(penX / canvas.width) * 100}%`;
		caret.style.top = `${(penY / canvas.height) * 100}%`;
		caret.dataset.down = penDown ? '1' : '';
	}

	canvas?.addEventListener('focus', () => {
		if (caret) caret.hidden = false;
		drawCaret();
	});

	canvas?.addEventListener('blur', () => {
		penDown = false;
		if (caret) caret.hidden = true;
	});

	canvas?.addEventListener('keydown', (e) => {
		if (!ink || !canvas) return;

		const step = e.shiftKey ? 24 : 8;
		const dx = Number(e.key === 'ArrowRight') - Number(e.key === 'ArrowLeft');
		const dy = Number(e.key === 'ArrowDown') - Number(e.key === 'ArrowUp');

		if (dx || dy) {
			e.preventDefault();
			penX = Math.max(0, Math.min(canvas.width, penX + dx * step));
			penY = Math.max(0, Math.min(canvas.height, penY + dy * step));
			if (penDown) {
				ink.lineTo(penX, penY);
				ink.stroke();
			}
			drawCaret();
			return;
		}

		// Enter would otherwise submit the form this pad sits inside.
		if (e.key === ' ' || e.key === 'Enter') {
			e.preventDefault();
			penDown = !penDown;
			if (penDown) {
				dirty = true;
				ink.beginPath();
				ink.moveTo(penX, penY);
				ink.lineTo(penX + 0.1, penY + 0.1); // pen down alone leaves a dot
				ink.stroke();
			}
			drawCaret();
		}
	});

	function clearPad() {
		if (ink && canvas) ink.clearRect(0, 0, canvas.width, canvas.height);
		dirty = false;
		penDown = false;
		if (canvas) {
			penX = canvas.width / 2;
			penY = canvas.height / 2;
		}
		drawCaret();
	}
	padClear?.addEventListener('click', clearPad);

	padToggle?.addEventListener('click', () => {
		if (!pad) return;
		pad.hidden = !pad.hidden;
		padToggle.setAttribute('aria-expanded', String(!pad.hidden));
		padToggle.textContent = pad.hidden ? '✏️ Doodle' : '✏️ Doodle — on';
	});

	// Shrink the sketch to note size so the stored PNG stays tiny. Returns
	// 'too-big' rather than null when the drawing blows the size cap, so the
	// caller can say so instead of silently dropping someone's sketch.
	function exportDoodle(): string | 'too-big' | null {
		if (!dirty || !canvas || pad?.hidden) return null;
		const out = document.createElement('canvas');
		out.width = 180;
		out.height = 126;
		out.getContext('2d')!.drawImage(canvas, 0, 0, out.width, out.height);
		const url = out.toDataURL('image/png');
		return url.length <= 24000 ? url : 'too-big';
	}

	// --- Drag notes around the wall (never saved — just playful) ---
	// MUST run after the note is in the DOM: Draggable measures the element
	// on creation, and a detached note measures at (0,0), which made bounds
	// shove every note off the wall. Bounds are the guestbook section so a
	// dragged note can never stretch the page taller.
	const wallBounds = document.querySelector<HTMLElement>('.guestbook');
	function makeDraggable(el: HTMLElement) {
		if (!canDrag) return;
		Draggable.create(el, {
			type: 'x,y',
			bounds: wallBounds ?? undefined,
			edgeResistance: 0.8,
			onDragStart() {
				el.dataset.dragging = '1';
				gsap.to(el, { scale: 1.06, rotation: 0, duration: 0.2, ease: 'power2.out' });
			},
			onRelease() {
				delete el.dataset.dragging;
				gsap.to(el, {
					scale: 1,
					rotation: Number(el.dataset.tilt || 0),
					duration: 0.7,
					ease: 'elastic.out(1, 0.4)',
				});
			},
		});
	}

	// Build a note with textContent only — visitor text is never treated
	// as HTML, so a note can't inject markup onto the page. The doodle is
	// only accepted if it looks exactly like our own small PNG data URLs.
	function noteEl(row: Row) {
		const li = document.createElement('li');
		li.className = 'gb-note';

		const h = hash(row.name + row.message + row.created_at);
		li.dataset.paper = String(h % PAPER_COUNT);
		const tilt = ((h >> 3) % 7) - 3; // -3..3 deg, deterministic per note
		li.dataset.tilt = String(tilt);
		li.style.setProperty('--tilt', `${tilt}deg`);

		const pin = document.createElement('span');
		pin.className = 'gb-pin';
		pin.setAttribute('aria-hidden', 'true');
		li.append(pin);

		if (row.mood) {
			const stamp = document.createElement('span');
			stamp.className = 'gb-stamp';
			stamp.textContent = row.mood.slice(0, 8);
			li.append(stamp);
		}

		const who = document.createElement('span');
		who.className = 'gb-who';
		who.textContent = row.name;
		li.append(who);

		if (row.doodle && DOODLE_RE.test(row.doodle)) {
			const img = document.createElement('img');
			img.className = 'gb-doodle';
			img.src = row.doodle;
			img.alt = `${row.name}'s doodle`;
			img.width = 180;
			img.height = 126;
			li.append(img);
		}

		if (row.message) {
			const body = document.createElement('p');
			body.className = 'gb-text';
			body.textContent = row.message;
			li.append(body);
		}

		const when = document.createElement('span');
		when.className = 'gb-when';
		when.textContent = ago(row.created_at);
		li.append(when);

		if (!reduced) addWobble(li);
		return li;
	}

	// Hover: lift the note and straighten it, then let it swing back on its pin.
	// Skipped mid-drag so it doesn't fight Draggable for the transform.
	function addWobble(el: HTMLElement) {
		el.addEventListener('mouseenter', () => {
			if (el.dataset.dragging) return;
			el.style.zIndex = '3';
			gsap.to(el, { scale: 1.05, rotation: 0, duration: 0.3, ease: 'power2.out' });
		});
		el.addEventListener('mouseleave', () => {
			if (el.dataset.dragging) return;
			gsap.to(el, {
				scale: 1,
				rotation: Number(el.dataset.tilt || 0),
				duration: 0.8,
				ease: 'elastic.out(1, 0.4)',
				onComplete: () => { el.style.zIndex = ''; },
			});
		});
	}

	// Drop each note onto the wall: falls in slightly over-rotated and
	// snaps back to its resting tilt, like it just got pinned. Plays
	// immediately — gating it on scroll position once left the whole wall
	// stuck invisible, which read as a giant empty gap in the page.
	function stickIn(notes: HTMLElement[]) {
		if (reduced || !notes.length) return;
		gsap.from(notes, {
			y: -30,
			opacity: 0,
			scale: 0.55,
			rotation: (_i: number, el: HTMLElement) => Number(el.dataset.tilt || 0) * 3 + 8,
			duration: 0.55,
			ease: 'back.out(2.2)',
			stagger: 0.06,
		});
	}

	// Signatures of notes THIS visitor just signed — the realtime event for
	// them would double-pin the note we already showed optimistically.
	const ownNotes = new Set<string>();

	// Live wall: someone else's note pins itself on while you watch.
	function watchWall() {
		if (!supabase || !list) return;
		supabase
			.channel('guestbook-live')
			.on(
				'postgres_changes',
				{ event: 'INSERT', schema: 'public', table: 'guestbook' },
				(payload) => {
					const row = payload.new as Row;
					if (ownNotes.has(row.name + '|' + row.message)) return;
					const note = noteEl(row);
					list!.prepend(note);
					makeDraggable(note);
					stickIn([note]);
				}
			)
			.subscribe();
	}

	async function load() {
		if (!supabase || !list) return;
		const { data, error } = await supabase
			.from('guestbook')
			.select('name, message, created_at, mood, doodle')
			.order('created_at', { ascending: false })
			.limit(40);
		if (error) return;
		const notes = (data ?? []).map(noteEl);
		list.replaceChildren(...notes);
		notes.forEach(makeDraggable);
		stickIn(notes);
		if (!reduced) ScrollTrigger.refresh(); // page grew — keep other triggers honest
	}

	if (!supabase) {
		// Not wired up yet — keep it honest rather than showing a broken form.
		form?.setAttribute('hidden', '');
		say('The wall is warming up — check back soon.');
		status?.removeAttribute('hidden');
	} else if (form) {
		load();
		watchWall();
		form.addEventListener('submit', async (e) => {
			e.preventDefault();
			const fd = new FormData(form);
			const name = String(fd.get('name') || '').trim();
			const message = String(fd.get('message') || '').trim();
			const sketch = exportDoodle();
			if (sketch === 'too-big') {
				say('That sketch has too much detail to save — simplify it or hit Clear.', 'err');
				return;
			}
			const doodle = sketch;
			if (!name) return;
			if (!message && !doodle) {
				say('Write something or doodle something 🙃', 'err');
				return;
			}

			btn && (btn.disabled = true);
			say('Signing…');
			const sig = name + '|' + message;
			ownNotes.add(sig);
			setTimeout(() => ownNotes.delete(sig), 15000);
			const { error } = await supabase
				.from('guestbook')
				.insert({ name, message, mood, doodle });
			btn && (btn.disabled = false);

			if (error) {
				say('Ay, that one failed — try again.', 'err');
				return;
			}
			form.reset();
			say('Signed — thank ya!', 'ok');
			// Pin the fresh note to the wall right away without a round-trip.
			const note = noteEl({
				name,
				message,
				created_at: new Date().toISOString(),
				mood,
				doodle,
			});
			list?.prepend(note);
			makeDraggable(note);
			stickIn([note]);
			// Reset the extras for the next visitor.
			clearPad();
			mood = null;
			moodBtns.forEach((x) => x.setAttribute('aria-pressed', 'false'));
			setTimeout(() => say(''), 2500);
		});
	}
</script>

<style>
	.guestbook {
		margin-top: clamp(3.5rem, 9vh, 6rem);
		margin-bottom: clamp(3.5rem, 9vh, 6rem);
	}

	.wrap {
		max-width: var(--content);
		margin: 0 auto;
	}

	.heading {
		margin: 0 0 1.35rem;
		font-size: 1.0625rem;
		font-weight: 600;
		letter-spacing: -0.015em;
		color: var(--text);
	}

	.lead {
		margin: 0 0 1.5rem;
		color: var(--muted);
	}

	.gb-form {
		margin-bottom: 2.25rem;
	}

	.fields {
		display: grid;
		grid-template-columns: minmax(0, 12rem) minmax(0, 1fr) auto;
		align-items: end;
		gap: 0.9rem;
	}

	/* Material-style text field: a label that floats up out of the field and an
	   accent underline that grows in when the input is focused. */
	.field {
		position: relative;
		min-width: 0;
	}

	.gb-input {
		font: inherit;
		font-size: 1rem;
		width: 100%;
		color: var(--text);
		background: transparent;
		border: none;
		border-bottom: 1px solid var(--line);
		border-radius: 0;
		padding: 1.4rem 0.15rem 0.45rem;
		transition: border-color 0.2s ease;
		min-width: 0;
	}

	textarea.gb-input {
		display: block;
		resize: vertical;
		min-height: 4.4rem;
		line-height: 1.5;
	}

	/* The animated accent underline below is the focus indicator here, which is
	   why removing the native ring is safe. */
	.gb-input:focus {
		outline: none;
	}

	.field::after {
		content: '';
		position: absolute;
		left: 0;
		right: 0;
		bottom: 0;
		height: 2px;
		background: var(--accent);
		transform: scaleX(0);
		transition: transform 0.25s ease;
		pointer-events: none;
	}

	.field:focus-within::after {
		transform: scaleX(1);
	}

	.gb-lbl {
		position: absolute;
		left: 0.15rem;
		top: 1.4rem;
		color: var(--faint);
		pointer-events: none;
		transform-origin: left top;
		transition: transform 0.2s ease, color 0.2s ease;
	}

	/* Filled but blurred → label parks up top in muted; focused → accent. */
	.gb-input:not(:placeholder-shown) + .gb-lbl {
		transform: translateY(-1.25rem) scale(0.78);
		color: var(--muted);
	}

	.gb-input:focus + .gb-lbl {
		transform: translateY(-1.25rem) scale(0.78);
		color: var(--accent);
	}

	.gb-send {
		font: inherit;
		font-weight: 500;
		color: var(--bg);
		background: var(--text);
		border: none;
		border-radius: 10px;
		padding: 0.6rem 1.2rem;
		cursor: pointer;
		transition: opacity 0.25s ease;
	}

	.gb-send:hover {
		opacity: 0.85;
	}

	.gb-send:disabled {
		opacity: 0.5;
		cursor: default;
	}

	/* --- Mood picker + doodle toggle row --- */
	.gb-extras {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 0.9rem;
		flex-wrap: wrap;
		margin-top: 0.9rem;
	}

	.gb-moods {
		display: flex;
		gap: 0.3rem;
	}

	.gb-mood-btn {
		font: inherit;
		font-size: 1rem;
		line-height: 1;
		padding: 0.35rem 0.45rem;
		background: transparent;
		border: 1px solid transparent;
		border-radius: 10px;
		cursor: pointer;
		filter: grayscale(0.7);
		transition: transform 0.2s ease, filter 0.2s ease, border-color 0.2s ease;
	}

	.gb-mood-btn:hover {
		filter: grayscale(0);
		transform: scale(1.15) rotate(-6deg);
	}

	.gb-mood-btn[aria-pressed='true'] {
		filter: grayscale(0);
		border-color: var(--accent);
		transform: scale(1.1);
	}

	.gb-pad-toggle,
	.gb-pad-clear {
		font: inherit;
		font-size: 0.8125rem;
		color: var(--muted);
		background: transparent;
		border: 1px solid var(--line);
		border-radius: 10px;
		padding: 0.35rem 0.7rem;
		cursor: pointer;
		transition: color 0.2s ease, border-color 0.2s ease;
	}

	.gb-pad-toggle:hover,
	.gb-pad-clear:hover {
		color: var(--text);
		border-color: var(--faint);
	}

	.gb-pad-toggle[aria-expanded='true'] {
		color: var(--accent);
		border-color: var(--accent);
	}

	/* --- The doodle pad: a blank sticky note you draw on --- */
	.gb-pad {
		margin-top: 0.9rem;
	}

