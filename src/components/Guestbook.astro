---
// Visitor guestbook — leave a short signed note that everyone can see.
// Persists to Supabase (public read + insert, guarded by RLS).
// Notes render as colored sticky notes pinned to the wall.
---

<section class="guestbook">
	<div class="wrap">
		<h2 class="heading" data-anim="fade">Guestbook</h2>
		<p class="lead" data-anim="fade">Drop ya note, my paddy — make the world know you pass here.</p>

		<form class="gb-form" data-gb-form autocomplete="off">
			<div class="fields">
				<div class="field">
					<input
						class="gb-input gb-name"
						id="gb-name"
						name="name"
						type="text"
						maxlength="40"
						required
						placeholder=" "
					/>
					<label class="gb-lbl" for="gb-name">Ya name</label>
				</div>
				<div class="field">
					<input
						class="gb-input gb-msg"
						id="gb-message"
						name="message"
						type="text"
						maxlength="280"
						required
						placeholder=" "
					/>
					<label class="gb-lbl" for="gb-message">Say something small…</label>
				</div>
				<button class="gb-send" type="submit" data-magnetic="0.35">Sign</button>
			</div>
			<p class="gb-status" data-gb-status role="status" aria-live="polite"></p>
		</form>

		<ul class="gb-list" data-gb-list aria-live="polite"></ul>
	</div>
</section>

<script>
	import { gsap } from 'gsap';
	import { ScrollTrigger } from 'gsap/ScrollTrigger';
	import { supabase } from '../lib/supabase';

	const reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
	if (!reduced) gsap.registerPlugin(ScrollTrigger);

	const form = document.querySelector<HTMLFormElement>('[data-gb-form]');
	const list = document.querySelector<HTMLElement>('[data-gb-list]');
	const status = document.querySelector<HTMLElement>('[data-gb-status]');
	const btn = form?.querySelector<HTMLButtonElement>('.gb-send');

	const PAPER_COUNT = 6;

	function say(msg: string, kind: 'ok' | 'err' | '' = '') {
		if (!status) return;
		status.textContent = msg;
		status.dataset.kind = kind;
	}

	// "3h ago"-style relative time, kept tiny and dependency-free.
	function ago(iso: string) {
		const s = Math.max(1, Math.round((Date.now() - new Date(iso).getTime()) / 1000));
		const steps: [number, string][] = [
			[60, 's'], [60, 'm'], [24, 'h'], [7, 'd'], [4.3, 'w'], [12, 'mo'],
		];
		let val = s, unit = 's';
		for (const [size, u] of steps) {
			if (val < size) { unit = u; break; }
			val = Math.round(val / size);
			unit = u;
		}
		return unit === 's' ? 'just now' : `${val}${unit} ago`;
	}

	// Cheap string hash so each note keeps the same paper color and tilt
	// across reloads instead of reshuffling every visit.
	function hash(s: string) {
		let h = 0;
		for (let i = 0; i < s.length; i++) h = (h * 31 + s.charCodeAt(i)) | 0;
		return Math.abs(h);
	}

	// Build a note with textContent only — visitor text is never treated
	// as HTML, so a note can't inject markup onto the page.
	function noteEl(row: { name: string; message: string; created_at: string }) {
		const li = document.createElement('li');
		li.className = 'gb-note';

		const h = hash(row.name + row.message + row.created_at);
		li.dataset.paper = String(h % PAPER_COUNT);
		const tilt = ((h >> 3) % 7) - 3; // -3..3 deg, deterministic per note
		li.dataset.tilt = String(tilt);
		li.style.setProperty('--tilt', `${tilt}deg`);

		const pin = document.createElement('span');
		pin.className = 'gb-pin';
		pin.setAttribute('aria-hidden', 'true');

		const who = document.createElement('span');
		who.className = 'gb-who';
		who.textContent = row.name;

		const body = document.createElement('p');
		body.className = 'gb-text';
		body.textContent = row.message;

		const when = document.createElement('span');
		when.className = 'gb-when';
		when.textContent = ago(row.created_at);

		li.append(pin, who, body, when);
		if (!reduced) addWobble(li);
		return li;
	}

	// Hover: lift the note and straighten it, then let it swing back on its pin.
	function addWobble(el: HTMLElement) {
		el.addEventListener('mouseenter', () => {
			el.style.zIndex = '3';
			gsap.to(el, { scale: 1.05, rotation: 0, duration: 0.3, ease: 'power2.out' });
		});
		el.addEventListener('mouseleave', () => {
			gsap.to(el, {
				scale: 1,
				rotation: Number(el.dataset.tilt || 0),
				duration: 0.8,
				ease: 'elastic.out(1, 0.4)',
				clearProps: 'transform',
				onComplete: () => { el.style.zIndex = ''; },
			});
		});
	}

	// Drop each note onto the wall: falls in slightly over-rotated and
	// snaps back to its resting tilt, like it just got pinned.
	function stickIn(notes: HTMLElement[], onScroll = false) {
		if (reduced || !notes.length) return;
		gsap.from(notes, {
			y: -30,
			opacity: 0,
			scale: 0.55,
			rotation: (_i: number, el: HTMLElement) => Number(el.dataset.tilt || 0) * 3 + 8,
			duration: 0.55,
			ease: 'back.out(2.2)',
			stagger: 0.06,
			clearProps: 'transform,opacity',
			...(onScroll && list
				? { scrollTrigger: { trigger: list, start: 'top 88%' } }
				: {}),
		});
	}

	async function load() {
		if (!supabase || !list) return;
		const { data, error } = await supabase
			.from('guestbook')
			.select('name, message, created_at')
			.order('created_at', { ascending: false })
			.limit(40);
		if (error) return;
		const notes = (data ?? []).map(noteEl);
		list.replaceChildren(...notes);
		stickIn(notes, true);
		if (!reduced) ScrollTrigger.refresh(); // page grew — keep other triggers honest
	}

	if (!supabase) {
		// Not wired up yet — keep it honest rather than showing a broken form.
		form?.setAttribute('hidden', '');
		say('The wall is warming up — check back soon.');
		status?.removeAttribute('hidden');
	} else if (form) {
		load();
		form.addEventListener('submit', async (e) => {
			e.preventDefault();
			const fd = new FormData(form);
			const name = String(fd.get('name') || '').trim();
			const message = String(fd.get('message') || '').trim();
			if (!name || !message) return;

			btn && (btn.disabled = true);
			say('Signing…');
			const { error } = await supabase.from('guestbook').insert({ name, message });
			btn && (btn.disabled = false);

			if (error) {
				say('Ay, that one failed — try again.', 'err');
				return;
			}
			form.reset();
			say('Signed — thank ya!', 'ok');
			// Pin the fresh note to the wall right away without a round-trip.
			const note = noteEl({ name, message, created_at: new Date().toISOString() });
			list?.prepend(note);
			stickIn([note]);
			setTimeout(() => say(''), 2500);
		});
	}
</script>

<style>
	.guestbook {
		margin-top: clamp(3.5rem, 9vh, 6rem);
		margin-bottom: clamp(3.5rem, 9vh, 6rem);
	}

	.wrap {
		max-width: var(--content);
		margin: 0 auto;
	}

	.heading {
		margin: 0 0 0.5rem;
		padding-top: 1.75rem;
		border-top: 1px solid var(--line);
		font-size: 0.9375rem;
		font-weight: 400;
		color: var(--muted);
	}

	.lead {
		margin: 0 0 1.5rem;
		color: var(--muted);
	}

	.gb-form {
		margin-bottom: 2.25rem;
	}

	.fields {
		display: grid;
		grid-template-columns: minmax(0, 12rem) minmax(0, 1fr) auto;
		align-items: end;
		gap: 0.9rem;
	}

	/* Material-style text field: a label that floats up out of the field and an
	   accent underline that grows in when the input is focused. */
	.field {
		position: relative;
		min-width: 0;
	}

	.gb-input {
		font: inherit;
		font-size: 1rem;
		width: 100%;
		color: var(--text);
		background: transparent;
		border: none;
		border-bottom: 1px solid var(--line);
		border-radius: 0;
		padding: 1.4rem 0.15rem 0.45rem;
		transition: border-color 0.2s ease;
		min-width: 0;
	}

	.gb-input:focus {
		outline: none;
	}

	.field::after {
		content: '';
		position: absolute;
		left: 0;
		right: 0;
		bottom: 0;
		height: 2px;
		background: var(--accent);
		transform: scaleX(0);
		transition: transform 0.25s ease;
		pointer-events: none;
	}

	.field:focus-within::after {
		transform: scaleX(1);
	}

	.gb-lbl {
		position: absolute;
		left: 0.15rem;
		top: 1.4rem;
		color: var(--faint);
		pointer-events: none;
		transform-origin: left top;
		transition: transform 0.2s ease, color 0.2s ease;
	}

	/* Filled but blurred → label parks up top in muted; focused → accent. */
	.gb-input:not(:placeholder-shown) + .gb-lbl {
		transform: translateY(-1.25rem) scale(0.78);
		color: var(--muted);
	}

	.gb-input:focus + .gb-lbl {
		transform: translateY(-1.25rem) scale(0.78);
		color: var(--accent);
	}

	.gb-send {
		font: inherit;
		font-weight: 500;
		color: var(--bg);
		background: var(--text);
		border: none;
		border-radius: 10px;
		padding: 0.6rem 1.2rem;
		cursor: pointer;
		transition: opacity 0.25s ease;
	}

	.gb-send:hover {
		opacity: 0.85;
	}

	.gb-send:disabled {
		opacity: 0.5;
		cursor: default;
	}

	.gb-status {
		margin: 0.7rem 0 0;
		min-height: 1.2em;
		font-size: 0.875rem;
		color: var(--muted);
	}

	.gb-status[data-kind='ok'] {
		color: #3fa66a;
	}

	.gb-status[data-kind='err'] {
		color: #d8574b;
	}

	/* --- The wall: a grid of small sticky notes --- */
	.gb-list {
		list-style: none;
		margin: 0;
		padding: 0.25rem 0;
		display: grid;
		grid-template-columns: repeat(auto-fill, minmax(9.5rem, 1fr));
		gap: 1.15rem;
		align-items: start;
	}

	/* Notes are built in JS at runtime, so they never receive Astro's scoped
	   hash — style them with :global so the rules actually apply. */
	.gb-list :global(.gb-note) {
		position: relative;
		display: flex;
		flex-direction: column;
		gap: 0.3rem;
		min-height: 7.5rem;
		max-width: 13rem;
		padding: 1.5rem 0.8rem 0.7rem;
		border-radius: 2px;
		transform: rotate(var(--tilt, 0deg));
		background: linear-gradient(
			175deg,
			color-mix(in srgb, var(--paper) 88%, #fff) 0%,
			var(--paper) 55%,
			color-mix(in srgb, var(--paper) 90%, #000) 100%
		);
		color: #3a3226;
		box-shadow:
			0 1px 2px rgba(0, 0, 0, 0.14),
			0 8px 14px -6px rgba(0, 0, 0, 0.28);
		font-size: 0.8125rem;
		line-height: 1.45;
		word-break: break-word;
	}

	/* Each note gets its paper color from a deterministic hash of its content. */
	.gb-list :global(.gb-note[data-paper='0']) { --paper: #ffd76b; }
	.gb-list :global(.gb-note[data-paper='1']) { --paper: #ffb3ba; }
	.gb-list :global(.gb-note[data-paper='2']) { --paper: #b4e7a8; }
	.gb-list :global(.gb-note[data-paper='3']) { --paper: #a8d8ff; }
	.gb-list :global(.gb-note[data-paper='4']) { --paper: #d9c7ff; }
	.gb-list :global(.gb-note[data-paper='5']) { --paper: #ffcf9e; }

	/* Red pushpin holding the note to the wall. */
	.gb-list :global(.gb-pin) {
		position: absolute;
		top: 0.45rem;
		left: 50%;
		width: 0.8rem;
		height: 0.8rem;
		transform: translateX(-50%);
		border-radius: 50%;
		background: radial-gradient(circle at 32% 30%, #ff8a7a, #d0342c 58%, #8f1d16);
		box-shadow:
			0 2px 3px rgba(0, 0, 0, 0.35),
			inset 0 -1px 2px rgba(0, 0, 0, 0.25);
	}

	/* Tiny needle shadow cast on the paper just under the pin head. */
	.gb-list :global(.gb-pin)::after {
		content: '';
		position: absolute;
		top: 100%;
		left: 50%;
		width: 2px;
		height: 0.3rem;
		transform: translateX(-50%);
		background: rgba(0, 0, 0, 0.22);
		border-radius: 0 0 2px 2px;
	}

	.gb-list :global(.gb-who) {
		font-weight: 700;
		font-size: 0.8125rem;
		letter-spacing: -0.01em;
		overflow-wrap: anywhere;
	}

	.gb-list :global(.gb-text) {
		margin: 0;
		flex: 1;
		color: rgba(42, 35, 24, 0.82);
		overflow-wrap: anywhere;
	}

	.gb-list :global(.gb-when) {
		align-self: flex-end;
		font-size: 0.6875rem;
		color: rgba(42, 35, 24, 0.55);
		font-variant-numeric: tabular-nums;
	}

	@media (max-width: 560px) {
		.fields {
			grid-template-columns: 1fr;
		}

		.gb-send {
			justify-self: start;
			padding: 0.6rem 1.6rem;
		}

		.gb-list {
			grid-template-columns: repeat(auto-fill, minmax(8.5rem, 1fr));
			gap: 0.9rem;
		}
	}
</style>
