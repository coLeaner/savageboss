---
import '@fontsource-variable/inter';
import '@fontsource-variable/jetbrains-mono';
import '@fontsource/fragment-mono/latin-400.css';
import '@fontsource/fragment-mono/latin-400-italic.css';
// Hashed URL for the one subset every visitor actually needs, so it can be
// preloaded instead of waiting on the CSS to parse first.
import fragmentLatin from '@fontsource/fragment-mono/files/fragment-mono-latin-400-normal.woff2?url';
import CursorDot from '../components/CursorDot.astro';
import ThemeTransition from '../components/ThemeTransition.astro';

interface Props {
	title?: string;
	description?: string;
}

const {
	title = 'Abraham A. Sheriff — Web Developer',
	description = 'Abraham A. Sheriff is a web developer based in Paynesville City, Liberia, building simple, user-friendly digital solutions.',
} = Astro.props;

const canonical = new URL(Astro.url.pathname, Astro.site).href;
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="icon" href="/favicon.ico" />
		<link rel="canonical" href={canonical} />
		<link rel="preload" href={fragmentLatin} as="font" type="font/woff2" crossorigin />
		<meta name="generator" content={Astro.generator} />
		<title>{title}</title>
		<meta name="description" content={description} />
		<meta property="og:title" content={title} />
		<meta property="og:description" content={description} />
		<meta property="og:type" content="website" />
		<meta property="og:url" content={canonical} />
		<meta name="twitter:card" content="summary" />
		<!-- Browser chrome matches the page background in each theme. -->
		<meta name="theme-color" content="#0e0e10" media="(prefers-color-scheme: dark)" />
		<meta name="theme-color" content="#f4f3ee" media="(prefers-color-scheme: light)" />
		<script is:inline>
			// Runs before paint: flag JS + reduced-motion so CSS can hide
			// animated elements only when we can actually animate them.
			(function () {
				var d = document.documentElement;
				d.classList.add('js');
				try {
					if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
						d.classList.add('reduce-motion');
					}
					var stored = localStorage.getItem('theme');
					if (stored === 'light' || stored === 'dark') {
						d.setAttribute('data-theme', stored);
					}
					var font = localStorage.getItem('font');
					if (font === 'mono' || font === 'sans') {
						d.setAttribute('data-font', font);
					}
				} catch (e) {}

				// Safety net for the rule above, which hides every [data-anim]
				// until GSAP reveals it. If GSAP never gets to run — chunk
				// blocked, a throw earlier in the script, a tab whose rAF loop
				// is frozen — that rule would leave a permanently blank page.
				// After 3s we un-hide unconditionally: anything GSAP already
				// claimed carries its own inline opacity and is unaffected.
				setTimeout(function () {
					d.classList.add('anim-bailout');
				}, 3000);
			})();
		</script>
	</head>
	<body>
		<button id="theme-toggle" type="button" data-magnetic="0.4" aria-label="Toggle color theme" title="Toggle theme">
			<svg class="i-sun" viewBox="0 0 24 24" aria-hidden="true">
				<circle cx="12" cy="12" r="4"></circle>
				<path d="M12 2v2M12 20v2M4.93 4.93l1.41 1.41M17.66 17.66l1.41 1.41M2 12h2M20 12h2M4.93 19.07l1.41-1.41M17.66 6.34l1.41-1.41"></path>
			</svg>
			<svg class="i-moon" viewBox="0 0 24 24" aria-hidden="true">
				<path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"></path>
			</svg>
		</button>
		<slot />
		<CursorDot />

		<ThemeTransition />
	</body>
</html>

<style is:global>
	@font-face {
		font-family: 'Swansea';
		src: url('/fonts/swansea.ttf') format('truetype');
		font-weight: 400;
		font-style: normal;
		font-display: swap;
	}

	:root {
		--content: 48rem;
		--gutter: clamp(1.25rem, 5vw, 2rem);
		--font-sans: 'Inter Variable', system-ui, -apple-system, sans-serif;
		--font-mono: 'JetBrains Mono Variable', ui-monospace, 'SFMono-Regular', monospace;
		--font: 'Fragment Mono', ui-monospace, monospace;
		--font-display: 'Swansea', var(--font-sans);
	}

	:root[data-font='sans'] {
		--font: var(--font-sans);
		--font-display: var(--font-sans);
	}

	:root[data-font='mono'] {
		--font: var(--font-mono);
		--font-display: var(--font-mono);
	}

	/* Dark palette — the default, and whenever the user picks dark. */
	:root,
	:root[data-theme='dark'] {
		--bg: #0e0e10;
		--page-texture: url('/textures/grain.svg');
		--text: #ecEae4;
		/* Contrast on --bg: muted 6.7:1, faint 4.7:1 — both clear WCAG AA.
		   --line is decorative only and is exempt. */
		--muted: #9b9990;
		--faint: #7f7d76;
		--line: rgba(236, 234, 228, 0.1);
		--tag-building-fg: #8ab4ff;
		--tag-building-bg: rgba(138, 180, 255, 0.14);
		--tag-data-fg: #f5b56b;
		--tag-data-bg: rgba(245, 181, 107, 0.14);
		--accent: #8ab4ff;
		--polaroid-bg: #f6f5f1;
		--polaroid-shadow: rgba(0, 0, 0, 0.7);
		/* Card surface used by the contributions panel and the row tiles. */
		--card: #141417;
		--card-line: rgba(236, 234, 228, 0.09);
		/* Heatmap ramp: empty cell, then four steps of increasing activity. */
		--heat-0: rgba(236, 234, 228, 0.045);
		--heat-1: #0e4429;
		--heat-2: #006d32;
		--heat-3: #26a641;
		--heat-4: #39d353;
		color-scheme: dark;
	}

	/* Light palette — a warm off-white, editorial like the reference. */
	:root[data-theme='light'] {
		--bg: #f4f3ee;
		--page-texture: none;
		--text: #17171a;
		/* Contrast on --bg: muted 6.8:1, faint 4.8:1 — both clear WCAG AA. */
		--muted: #57564e;
		--faint: #6e6c63;
		--line: rgba(20, 20, 20, 0.12);
		/* Darker than the dark-theme pair: these sit on a 12%-tint chip, which
		   lands near-white in light mode, so the text has to carry the contrast. */
		--tag-building-fg: #1d52c2;
		--tag-building-bg: rgba(47, 111, 237, 0.12);
		--tag-data-fg: #8f4703;
		--tag-data-bg: rgba(180, 94, 12, 0.12);
		--accent: #2a63d6;
		--polaroid-bg: #ffffff;
		--polaroid-shadow: rgba(0, 0, 0, 0.28);
		--card: #ffffff;
		--card-line: rgba(20, 20, 20, 0.1);
		--heat-0: rgba(20, 20, 20, 0.05);
		--heat-1: #9be9a8;
		--heat-2: #40c463;
		--heat-3: #30a14e;
		--heat-4: #216e39;
		color-scheme: light;
	}

	/* Follow the OS when the visitor hasn't chosen explicitly. */
	@media (prefers-color-scheme: light) {
		:root:not([data-theme]) {
			--bg: #f4f3ee;
			--page-texture: none;
			--text: #17171a;
			--muted: #57564e;
			--faint: #6e6c63;
			--line: rgba(20, 20, 20, 0.12);
			--tag-building-fg: #1d52c2;
			--tag-building-bg: rgba(47, 111, 237, 0.12);
			--tag-data-fg: #8f4703;
			--tag-data-bg: rgba(180, 94, 12, 0.12);
			--accent: #2a63d6;
			--polaroid-bg: #ffffff;
			--polaroid-shadow: rgba(0, 0, 0, 0.28);
			--card: #ffffff;
			--card-line: rgba(20, 20, 20, 0.1);
			--heat-0: rgba(20, 20, 20, 0.05);
			--heat-1: #9be9a8;
			--heat-2: #40c463;
			--heat-3: #30a14e;
			--heat-4: #216e39;
			color-scheme: light;
		}
	}

	*,
	*::before,
	*::after {
		box-sizing: border-box;
	}

	html {
		-webkit-text-size-adjust: 100%;
	}

	body {
		margin: 0;
		background: var(--bg);
		/* Static grain stays behind content and never intercepts interaction. */
		background-image: var(--page-texture);
		background-size: 192px 192px;
		color: var(--text);
		font-family: var(--font);
		font-size: clamp(0.9375rem, 0.9rem + 0.15vw, 1rem);
		line-height: 1.65;
		letter-spacing: -0.006em;
		font-feature-settings: 'cv11', 'ss01';
		-webkit-font-smoothing: antialiased;
		text-rendering: optimizeLegibility;
		overflow-x: hidden;
		transition: background-color 0.45s ease, color 0.45s ease;
	}

	/* height: auto stops an <img>'s height attribute (a presentational hint
	   Astro's <Image> always emits) from overriding CSS aspect-ratio. */
	img {
		max-width: 100%;
		height: auto;
		display: block;
	}

	#theme-toggle {
		position: fixed;
		top: calc(clamp(1rem, 3vw, 1.75rem) + env(safe-area-inset-top));
		right: calc(clamp(1rem, 3vw, 1.75rem) + env(safe-area-inset-right));
		z-index: 50;
		width: 2.5rem;
		height: 2.5rem;
		display: grid;
		place-items: center;
		padding: 0;
		border: 1px solid var(--line);
		border-radius: 50%;
		background: color-mix(in srgb, var(--bg) 70%, transparent);
		color: var(--muted);
		cursor: pointer;
		-webkit-backdrop-filter: blur(8px);
		backdrop-filter: blur(8px);
		transition: color 0.25s ease, border-color 0.25s ease, transform 0.25s ease;
	}

	#theme-toggle:hover {
		color: var(--text);
		border-color: var(--faint);
		transform: rotate(15deg);
	}

	#theme-toggle svg {
		width: 1.15rem;
		height: 1.15rem;
		fill: none;
		stroke: currentColor;
		stroke-width: 1.7;
		stroke-linecap: round;
		stroke-linejoin: round;
	}

	#theme-toggle .i-moon {
		display: none;
	}

	:root[data-theme='light'] #theme-toggle .i-sun {
		display: none;
	}
	:root[data-theme='light'] #theme-toggle .i-moon {
		display: block;
	}

	@media (prefers-color-scheme: light) {
		:root:not([data-theme]) #theme-toggle .i-sun {
			display: none;
		}
		:root:not([data-theme]) #theme-toggle .i-moon {
			display: block;
		}
	}

	a {
		color: inherit;
	}

	/* One visible focus ring for everything interactive. :where() keeps this at
	   zero specificity so a component can still style its own, and
	   :focus-visible means mouse clicks don't trigger it. */
	:where(a, button, input, textarea, canvas, summary, [tabindex]):focus-visible {
		outline: 2px solid var(--accent);
		outline-offset: 3px;
		border-radius: 4px;
	}

	/* Kill the 300ms double-tap delay, and pick the tap flash deliberately
	   instead of inheriting the browser's grey box. */
	button,
	a,
	[data-polaroid],
	.trex {
		touch-action: manipulation;
		-webkit-tap-highlight-color: color-mix(in srgb, var(--accent) 22%, transparent);
	}

	/* Food flying from the feed button into Boss's mouth (see index.astro). */
	.food-bit {
		position: fixed;
		top: 0;
		left: 0;
		z-index: 9999;
		font-size: 1.5rem;
		line-height: 1;
		pointer-events: none;
		will-change: transform;
	}

	/* Confetti bits spawned by Boss's secret-code rampage (see index.astro). */
	.confetti-bit {
		position: fixed;
		top: 0;
		left: 0;
		width: 9px;
		height: 9px;
		border-radius: 2px;
		pointer-events: none;
		z-index: 9998;
		will-change: transform, opacity;
	}

	::selection {
		background: var(--text);
		color: var(--bg);
	}

	/* Animated elements start hidden ONLY when JS is on and motion is allowed,
	   so GSAP can reveal them without a flash. No-JS / reduce-motion = visible. */
	html.js:not(.reduce-motion):not(.anim-bailout) [data-anim],
	html.js:not(.reduce-motion):not(.anim-bailout) [data-fan] {
		opacity: 0;
	}

	@media (prefers-reduced-motion: reduce) {
		* {
			animation-duration: 0.001ms !important;
			transition-duration: 0.001ms !important;
		}
	}
</style>
