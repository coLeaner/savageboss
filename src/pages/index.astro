---
import Layout from '../layouts/Layout.astro';
import Intro from '../components/Intro.astro';
import Skills from '../components/Skills.astro';
import Work from '../components/Work.astro';
import OffScreen from '../components/OffScreen.astro';
import Hero from '../components/Hero.astro';
import Trex from '../components/Trex.astro';
import Contributions from '../components/Contributions.astro';
import Footer from '../components/Footer.astro';
---

<Layout>
	<main class="shell">
		<div class="col">
			<Intro />
			<Contributions />
			<Work />
			<Skills />
		</div>
		<!-- Polaroid row breaks out wider than the reading column -->
		<OffScreen />
		<Hero />
		<Footer />
	</main>
	<Trex />
</Layout>

<style>
	.shell {
		padding: 0 var(--gutter);
	}

	.col {
		max-width: var(--content);
		margin: 0 auto;
	}
</style>

<script>
	import { gsap } from 'gsap';
	import { ScrollTrigger } from 'gsap/ScrollTrigger';
	import { SplitText } from 'gsap/SplitText';
	import { MotionPathPlugin } from 'gsap/MotionPathPlugin';

	const reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

	if (!reduced) {
		gsap.registerPlugin(ScrollTrigger, SplitText, MotionPathPlugin);

		// --- Shatter: hover calmly on the big name and nothing happens, but
		// swipe across it fast and aggressively and the letters break apart,
		// rain down, then fly back together. Attached immediately (NOT behind
		// the fonts-ready gate below) so it works from the first second. ---
		const heroEl = document.querySelector<HTMLElement>('.hero-section .hero');
		const heroTags = gsap.utils.toArray<HTMLElement>('[data-tag]');
		if (heroEl && heroTags.length && window.matchMedia('(hover: hover)').matches) {
			let heat = 0;
			let lastX = 0, lastY = 0, lastT = 0;
			let shattering = false;
			let cooling = false;
			// Second trigger: quick repeated passes over the words count
			// as aggression even if raw speed never gets extreme.
			let streak = 0;
			let lastEnter = 0;

			const shatter = () => {
				shattering = true;
				heat = 0;
				gsap.set(heroTags, { x: 0, y: 0, scale: 1, rotate: 0, overwrite: 'auto' });

				const splits = heroTags.map((tag) => {
					tag.classList.add('shattered');
					return new SplitText(tag, { type: 'chars', charsClass: 'shard' });
				});
				const shards = splits.flatMap((s) => s.chars as HTMLElement[]);

				// Each shard pops up, spins away, and drops off the wall.
				shards.forEach((shard) => {
					gsap.timeline()
						.to(shard, {
							x: gsap.utils.random(-170, 170),
							rotation: gsap.utils.random(-260, 260),
							duration: 1,
							ease: 'power1.out',
						}, 0)
						.to(shard, {
							y: gsap.utils.random(-140, -40),
							duration: 0.3,
							ease: 'power2.out',
						}, 0)
						.to(shard, {
							y: gsap.utils.random(240, 440),
							duration: 0.7,
							ease: 'power2.in',
						}, 0.3)
						.to(shard, { opacity: 0, duration: 0.25, ease: 'power1.in' }, 0.75);
				});

				// Sweep the pieces back up and glue the name together again.
				gsap.delayedCall(1.55, () => {
					gsap.to(shards, {
						x: 0,
						y: 0,
						rotation: 0,
						opacity: 1,
						duration: 0.6,
						ease: 'back.out(1.5)',
						stagger: { each: 0.02, from: 'random' },
						onComplete: () => {
							splits.forEach((s) => s.revert());
							heroTags.forEach((t) => t.classList.remove('shattered'));
							shattering = false;
							cooling = true;
							setTimeout(() => (cooling = false), 1500);
						},
					});
				});
			};

			const tremble = () =>
				gsap.to(heroTags, {
					x: () => gsap.utils.random(-2.5, 2.5),
					y: () => gsap.utils.random(-1.5, 1.5),
					duration: 0.05,
					overwrite: 'auto',
					onComplete: () => gsap.set(heroTags, { x: 0, y: 0 }),
				});

			heroEl.addEventListener('pointermove', (e) => {
				if (shattering || cooling) return;
				const t = performance.now();
				if (lastT) {
					const dt = t - lastT;
					const dist = Math.hypot(e.clientX - lastX, e.clientY - lastY);
					// Fast, jerky movement heats the name up; calm hovering
					// cools it back down before anything breaks.
					heat = Math.max(0, heat * Math.pow(0.9992, dt) + dist);
					if (heat > 550) shatter();
					else if (heat > 300) tremble(); // it's about to give way
				}
				lastX = e.clientX;
				lastY = e.clientY;
				lastT = t;
			});
			heroEl.addEventListener('pointerleave', () => {
				lastT = 0;
				heat *= 0.7; // walking away lets it settle
			});

			// Rushing back and forth over the words: 3 quick entries
			// (a fast double pass over the name) breaks it too.
			heroTags.forEach((tag) => {
				tag.addEventListener('mouseenter', () => {
					if (shattering || cooling) return;
					const now = performance.now();
					streak = now - lastEnter < 650 ? streak + 1 : 1;
					lastEnter = now;
					if (streak >= 3) {
						streak = 0;
						shatter();
					} else if (streak >= 2) {
						tremble();
					}
				});
			});
		}

		// Wait for the variable font so SplitText measures line breaks correctly.
		const ready = (document as any).fonts?.ready ?? Promise.resolve();

		ready.then(() => {
			const ease = 'power3.out';

			// --- Intro: name + paragraphs reveal on load ---
			const intro = gsap.timeline({ defaults: { ease } });

			// Bottom hero highlight boxes wipe in left→right when scrolled into view.
			const tags = gsap.utils.toArray<HTMLElement>('[data-tag]');
			if (tags.length) {
				gsap.to(tags, {
					clipPath: 'inset(0 0% 0 0)',
					duration: 0.9,
					ease: 'power4.out',
					stagger: 0.16,
					scrollTrigger: { trigger: '.hero-section', start: 'top 82%' },
				});
				// Playful tilt on hover (paused while the name is in pieces).
				tags.forEach((tag, i) => {
					tag.addEventListener('mouseenter', () => {
						if (tag.classList.contains('shattered')) return;
						gsap.to(tag, {
							scale: 1.04,
							rotate: i === 0 ? -2.5 : 2.5,
							duration: 0.4,
							ease: 'power2.out',
						});
					});
					tag.addEventListener('mouseleave', () => {
						if (tag.classList.contains('shattered')) return;
						gsap.to(tag, {
							scale: 1,
							rotate: 0,
							duration: 0.6,
							ease: 'elastic.out(1, 0.5)',
						});
					});
				});

			}

			// Only the intro's own fades belong on the load timeline — they're
			// what you see first. Every other section heading gets its own
			// ScrollTrigger; chaining them all here meant the Guestbook heading
			// animated while it was 4000px below the fold.
			const fades = gsap.utils.toArray<HTMLElement>('[data-anim="fade"]');

			fades
				.filter((el) => el.closest('.intro'))
				.forEach((el) => {
					gsap.set(el, { y: 12 });
					intro.to(el, { opacity: 1, y: 0, duration: 0.7 }, '<0.15');
				});

			fades
				.filter((el) => !el.closest('.intro'))
				.forEach((el) => {
					gsap.fromTo(
						el,
						{ opacity: 0, y: 12 },
						{
							opacity: 1,
							y: 0,
							duration: 0.7,
							ease,
							scrollTrigger: { trigger: el, start: 'top 88%' },
						}
					);
				});

			// autoSplit re-measures the line breaks when the viewport changes —
			// without it a phone rotation leaves text reflowing inside masks
			// that were measured for the old width. The reveal itself only plays
			// on the first split; replaying it on every resize would re-animate
			// copy the visitor has already read.
			let firstSplit = true;
			gsap.utils.toArray<HTMLElement>('[data-anim="lines"]').forEach((el, i) => {
				gsap.set(el, { opacity: 1 });
				SplitText.create(el, {
					type: 'lines',
					mask: 'lines',
					autoSplit: true,
					onSplit: (self) =>
						firstSplit
							? gsap.from(self.lines, {
									yPercent: 100,
									opacity: 0,
									duration: 0.9,
									stagger: 0.08,
									ease,
									delay: 0.35 + i * 0.12,
								})
							: gsap.set(self.lines, { yPercent: 0, opacity: 1 }),
				});
			});
			firstSplit = false;

			// --- Skills grid: staggered entrance on scroll ---
			const cards = gsap.utils.toArray<HTMLElement>('[data-anim="cards"]');
			if (cards.length) {
				gsap.fromTo(
					cards,
					{ opacity: 0, y: 24 },
					{
						opacity: 1,
						y: 0,
						duration: 0.6,
						ease,
						stagger: { each: 0.05, from: 'start' },
						// Trigger on the section, not '.grid' — there are two
						// grids now (Tech / Strengths) and toArray() would only
						// ever watch the first.
						scrollTrigger: { trigger: '.skills', start: 'top 85%' },
					}
				);
			}

			// --- Skills chips: gentle lift on hover ---
			cards.forEach((card) => {
				card.addEventListener('mouseenter', () =>
					gsap.to(card, { y: -5, duration: 0.35, ease: 'power3.out' })
				);
				card.addEventListener('mouseleave', () =>
					gsap.to(card, { y: 0, duration: 0.5, ease: 'power3.out' })
				);
			});

			// --- Work rows: fade + slide up on scroll ---
			gsap.utils.toArray<HTMLElement>('[data-anim="row"]').forEach((row) => {
				gsap.fromTo(
					row,
					{ opacity: 0, y: 22 },
					{
						opacity: 1,
						y: 0,
						duration: 0.7,
						ease,
						scrollTrigger: { trigger: row, start: 'top 88%' },
					}
				);
			});

			// --- Work rows: GSAP slide on hover (color handled by CSS) ---
			// Scoped to rows containing a link: sliding a row that isn't
			// clickable promises something the row can't deliver.
			gsap.utils.toArray<HTMLElement>('.rowline:has(a)').forEach((row) => {
				const title = row.querySelector<HTMLElement>('.title');
				const cat = row.querySelector<HTMLElement>('.category');
				if (!title) return;
				const hover = 'power3.out';
				row.addEventListener('mouseenter', () => {
					gsap.to(title, { x: 10, duration: 0.4, ease: hover });
					if (cat) gsap.to(cat, { x: -4, duration: 0.4, ease: hover });
				});
				row.addEventListener('mouseleave', () => {
					gsap.to(title, { x: 0, duration: 0.45, ease: hover });
					if (cat) gsap.to(cat, { x: 0, duration: 0.45, ease: hover });
				});
			});

			// --- Polaroids: start stacked/tilted, then fan out on scroll ---
			const fan = document.querySelector<HTMLElement>('[data-fan]');
			const polaroids = gsap.utils.toArray<HTMLElement>('[data-polaroid]');
			if (fan && polaroids.length) {
				gsap.set(fan, { opacity: 1 });
				const mid = (polaroids.length - 1) / 2;
				// A 40° ring: every card sits on the circumference of one
				// circle whose centre is well below the row, each rotated
				// tangentially so it leans away from the middle. The end cards
				// land at ±20° for a flatter spread.
				const ARC = 40;
				const step = polaroids.length > 1 ? ARC / (polaroids.length - 1) : 0;

				fan.classList.add('circled');

				// Transforms don't affect layout, so the row has to be told how
				// tall the ring is or it overlaps whatever follows it.
				//
				// Derived from the card box rather than measured: reading back
				// the rotated bounding boxes proved unreliable. The photos carry
				// an aspect-ratio (see OffScreen.astro), so an untransformed
				// card has its final height before any image has loaded.
				const layout = () => {
					const w = polaroids[0].offsetWidth;
					const h = polaroids[0].offsetHeight;

					// The pivot distance is the circle's radius, and it's what
					// sets how far apart the cards sit: neighbours are a chord
					// 2·r·sin(step/2) apart, so a bigger circle opens the fan up
					// without changing its spread in degrees.
					//
					// Use 85% of the row's available width for a relaxed horizontal spread:
					// 2·r·sin(half) plus one card, with a little air at each edge.
					const half = (ARC / 2) * (Math.PI / 180);
					const radius = Math.max(0, (fan.clientWidth - w - 32) / (2 * Math.sin(half))) * 0.85;

					// Lowest point any corner reaches once every card is rotated
					// into place. Corners are relative to the pivot, which sits
					// `radius` below the card's top edge.
					const corners = [
						[-w / 2, -radius],
						[w / 2, -radius],
						[-w / 2, h - radius],
						[w / 2, h - radius],
					];

					let lowest = 0;
					polaroids.forEach((_, i) => {
						const a = ((i - mid) * step * Math.PI) / 180;
						for (const [x, y] of corners) {
							lowest = Math.max(
								lowest,
								radius + x * Math.sin(a) + y * Math.cos(a)
							);
						}
					});

					fan.style.setProperty('--fan-h', `${Math.ceil(lowest)}px`);
					polaroids.forEach((card) =>
						gsap.set(card, { transformOrigin: `50% ${radius}px` })
					);
				};

				// Stacked start state, then size the row around it.
				polaroids.forEach((card) => {
					gsap.set(card, { xPercent: -50, rotate: 0, y: 40, opacity: 0 });
				});
				layout();
				window.addEventListener('resize', layout);

				gsap.to(polaroids, {
					rotate: (i) => (i - mid) * step,
					y: 0,
					opacity: 1,
					duration: 1.1,
					ease: 'power3.out',
					stagger: 0.07,
					scrollTrigger: { trigger: fan, start: 'top 82%' },
					// The labels ride on rotated cards; undo the rotation so
					// they stay level and readable at the ends of the arc.
					onStart: () =>
						polaroids.forEach((card, i) => {
							const tip = card.querySelector<HTMLElement>('.tip');
							if (tip) gsap.set(tip, { rotate: -(i - mid) * step });
						}),
				});

				// The outer card keeps its fan pivot and stable hover area.
				// Only the inner frame lifts and scales around its own centre.
				polaroids.forEach((card) => {
					const frame = card.querySelector<HTMLElement>('.photo-frame');
					if (!frame) return;
					card.addEventListener('mouseenter', () => {
						gsap.to(frame, { scale: 1.08, y: -8, duration: 0.3, ease: 'power3.out', overwrite: 'auto' });
					});
					card.addEventListener('mouseleave', () => {
						gsap.to(frame, { scale: 1, y: 0, duration: 0.35, ease: 'power3.out', overwrite: 'auto' });
					});
				});

				// Hover label pill: pop up above each polaroid.
				polaroids.forEach((card) => {
					const tip = card.querySelector<HTMLElement>('.tip');
					if (!tip) return;
					const full = tip.textContent ?? '';
					let typeTimer: ReturnType<typeof setInterval>;
					gsap.set(tip, {
						y: 12,
						scale: 0.9,
						opacity: 0,
						transformOrigin: 'left bottom',
					});

					const typewrite = () => {
						clearInterval(typeTimer);
						let i = 0;
						tip.textContent = '';
						typeTimer = setInterval(() => {
							i++;
							tip.textContent = full.slice(0, i) + (i < full.length ? '|' : '');
							if (i >= full.length) clearInterval(typeTimer);
						}, 45);
					};

					card.addEventListener('mouseenter', () => {
						gsap.to(tip, {
							y: 0,
							scale: 1,
							opacity: 1,
							duration: 0.35,
							ease: 'back.out(2.2)',
						});
						typewrite();
					});
					card.addEventListener('mouseleave', () => {
						clearInterval(typeTimer);
						gsap.to(tip, {
							y: 12,
							scale: 0.9,
							opacity: 0,
							duration: 0.25,
							ease: 'power2.in',
							onComplete: () => (tip.textContent = full),
						});
					});
				});
			}

			// --- MotionPath: a paper plane orbits around ALL the photos ---
			const flightSvg = document.querySelector('.flight');
			const plane = document.querySelector('#plane');
			const pathEl = document.querySelector('#flightPath');
			let flightTween = null;

			const buildFlight = () => {
				if (!flightSvg || !plane || !pathEl || !polaroids.length) return;
				const W = flightSvg.clientWidth;
				const H = flightSvg.clientHeight;
				if (!W || !H) return;
				flightSvg.setAttribute('viewBox', `0 0 ${W} ${H}`);
				// Measure the photo cluster via layout boxes (ignores GSAP transforms).
				let minX = Infinity, maxX = -Infinity, minY = Infinity, maxY = -Infinity;
				polaroids.forEach((c) => {
					minX = Math.min(minX, c.offsetLeft);
					maxX = Math.max(maxX, c.offsetLeft + c.offsetWidth);
					minY = Math.min(minY, c.offsetTop);
					maxY = Math.max(maxY, c.offsetTop + c.offsetHeight);
				});
				const cx = (minX + maxX) / 2;
				const cy = (minY + maxY) / 2;
				const rx = (maxX - minX) / 2 + 28;
				const ry = (maxY - minY) / 2 + 22;
				const k = 0.5523;
				const ox = rx * k;
				const oy = ry * k;
				const d =
					`M ${cx - rx},${cy} ` +
					`C ${cx - rx},${cy - oy} ${cx - ox},${cy - ry} ${cx},${cy - ry} ` +
					`C ${cx + ox},${cy - ry} ${cx + rx},${cy - oy} ${cx + rx},${cy} ` +
					`C ${cx + rx},${cy + oy} ${cx + ox},${cy + ry} ${cx},${cy + ry} ` +
					`C ${cx - ox},${cy + ry} ${cx - rx},${cy + oy} ${cx - rx},${cy} Z`;
				pathEl.setAttribute('d', d);
				if (flightTween) flightTween.kill();
				gsap.set(plane, { opacity: 0 });
				flightTween = gsap.to(plane, {
					duration: 20,
					repeat: -1,
					ease: 'none',
					motionPath: { path: pathEl, align: pathEl, alignOrigin: [0.5, 0.5], autoRotate: true },
				});
				gsap.to(plane, { opacity: 1, duration: 0.6, delay: 0.1, ease: 'power1.out' });
			};

			buildFlight();
			let flightResize;
			window.addEventListener('resize', () => {
				clearTimeout(flightResize);
				flightResize = setTimeout(buildFlight, 200);
			});

			ScrollTrigger.refresh();
		});
	}

	// --- T-Rex greeter: greets, and gets angry if you keep poking it ---
	const greeter = document.querySelector<HTMLElement>('[data-greeter]');
	if (greeter) {
		const trex = greeter.querySelector<HTMLElement>('.trex');
		const bubble = greeter.querySelector<HTMLElement>('[data-bubble]');

		if (trex && bubble) {
			const nightHour = Number(
					new Intl.DateTimeFormat('en-US', {
						timeZone: 'Africa/Monrovia',
						hour: 'numeric',
						hourCycle: 'h23',
					}).format(new Date())
				);
				// Late Paynesville night → Boss dozes off (closed eyes + zzz).
				const isNight = nightHour >= 22 || nightHour < 6;
				const sleep = () => {
					greeter.classList.add('sleeping');
					trex.classList.add('sleeping');
				};
				const wake = () => {
					greeter.classList.remove('sleeping');
					trex.classList.remove('sleeping');
				};
				const friendly = isNight ? 'Zzz…' : "Hi, I'm Boss";
				if (isNight) {
					sleep();
					bubble.textContent = friendly;
				}
			const pokes = ['Hey!', 'Quit it.', "I'm warning you…"];
			const angry = 'APEX PREDATOR! 🦖';
			let clicks = 0;
			let calmTimer: ReturnType<typeof setTimeout>;

			// Boss is black and white now, so poking him can't warm him up
			// through lime to red. He tenses instead: the belly and spikes
			// close the gap to the body colour until he's one stark silhouette.
			// (These are inline fills, so they have to be theme tokens or they
			// would override the CSS in Trex.astro and stick on one theme.)
			const skins = trex.querySelectorAll<SVGElement>('.skin');
			const belly = trex.querySelector<SVGElement>('.belly');
			const spikes = trex.querySelectorAll<SVGElement>('.spike');
			const shade = (pct: number) =>
				`color-mix(in srgb, var(--boss-shade) ${pct}%, var(--boss-body))`;
			const levels = [
				null, // 0: resting — straight from the CSS
				shade(75),
				shade(50),
				shade(25),
				shade(0), // flat: belly and spikes vanish into the body
			];
			const paint = (level: number) => {
				const c = levels[level];
				skins.forEach((e) => (e.style.fill = ''));
				if (belly) belly.style.fill = c ?? '';
				spikes.forEach((e) => (e.style.fill = c ?? ''));
			};

			const showBubble = () =>
				reduced
					? gsap.set(bubble, { scale: 1, opacity: 1 })
					: gsap.to(bubble, { scale: 1, opacity: 1, duration: 0.35, ease: 'back.out(2)', overwrite: true });
			const hideBubble = () =>
				reduced
					? gsap.set(bubble, { scale: 0, opacity: 0 })
					: gsap.to(bubble, { scale: 0, opacity: 0, duration: 0.3, ease: 'back.in(2)', overwrite: true });

			const calmDown = () => {
				clicks = 0;
				greeter.classList.remove('angry');
				trex.classList.remove('angry');
				paint(0);
					if (isNight) sleep();
				bubble.textContent = friendly;
			};

			trex.addEventListener('click', () => {
					wake();
				clicks++;
				clearTimeout(calmTimer);
				paint(Math.min(clicks, 4));

				if (clicks >= 4) {
					greeter.classList.add('angry');
					trex.classList.add('angry');
					bubble.textContent = angry;
					if (!reduced) {
						gsap.fromTo(
							trex,
							{ rotation: -9 },
							{
								rotation: 9,
								duration: 0.07,
								repeat: 7,
								yoyo: true,
								ease: 'power1.inOut',
								onComplete: () => gsap.to(trex, { rotation: 0, duration: 0.15 }),
							}
						);
					}
				} else {
					bubble.textContent = pokes[Math.min(clicks - 1, pokes.length - 1)];
					if (!reduced) gsap.fromTo(trex, { scale: 0.88 }, { scale: 1, duration: 0.4, ease: 'back.out(3)' });
				}

				showBubble();
				// Boss cools off after you leave him alone for a bit.
				calmTimer = setTimeout(() => {
					calmDown();
					hideBubble();
				}, 4500);
			});

			// Bubble reappears on hover, tucks away on leave.
			greeter.addEventListener('mouseenter', showBubble);
			greeter.addEventListener('mouseleave', hideBubble);

				// --- Secret code: type "boss" or the Konami code to unleash Boss ---
				const confettiBurst = () => {
					const rect = trex.getBoundingClientRect();
					const ox = rect.left + rect.width / 2;
					const oy = rect.top + rect.height / 2;
					const colors = ['#f3b5e5', '#f5921f', '#8ab4ff', '#8fbf3f', '#d83a2c', '#f5b56b'];
					for (let i = 0; i < 46; i++) {
						const bit = document.createElement('div');
						bit.className = 'confetti-bit';
						bit.style.background = colors[i % colors.length];
						bit.style.left = ox + 'px';
						bit.style.top = oy + 'px';
						document.body.appendChild(bit);
						const angle = Math.random() * Math.PI * 2;
						const dist = 90 + Math.random() * 170;
						gsap.set(bit, { xPercent: -50, yPercent: -50, rotation: Math.random() * 360 });
						gsap.to(bit, {
							x: Math.cos(angle) * dist,
							y: Math.sin(angle) * dist - 70,
							rotation: '+=' + (Math.random() * 720 - 360),
							duration: 1 + Math.random() * 0.5,
							ease: 'power2.out',
						});
						gsap.to(bit, {
							y: '+=340',
							opacity: 0,
							duration: 1.1,
							delay: 0.35 + Math.random() * 0.3,
							ease: 'power1.in',
							onComplete: () => bit.remove(),
						});
					}
				};

				const roar = () => {
					wake();
					clearTimeout(calmTimer);
					clicks = 4;
					greeter.classList.add('angry');
					trex.classList.add('angry');
					paint(4);
					bubble.textContent = 'RAAAWR! APEX PREDATOR 🦖';
					showBubble();
					if (!reduced) {
						gsap.fromTo(
							trex,
							{ rotation: -12 },
							{
								rotation: 12,
								duration: 0.06,
								repeat: 11,
								yoyo: true,
								ease: 'power1.inOut',
								onComplete: () => gsap.to(trex, { rotation: 0, duration: 0.2 }),
							}
						);
						gsap.fromTo(
							trex,
							{ scale: 1 },
							{ scale: 1.35, duration: 0.45, ease: 'back.out(3)', yoyo: true, repeat: 1 }
						);
						confettiBurst();
					}
					// Boss cools back down after the rampage.
					calmTimer = setTimeout(() => {
						calmDown();
						hideBubble();
					}, 6000);
				};

				const konami = [
					'arrowup', 'arrowup', 'arrowdown', 'arrowdown',
					'arrowleft', 'arrowright', 'arrowleft', 'arrowright', 'b', 'a',
				];
				let keyBuf: string[] = [];
				window.addEventListener('keydown', (e) => {
					// Don't hijack typing in the guestbook or any field.
					const t = e.target as HTMLElement | null;
					if (t && (t.tagName === 'INPUT' || t.tagName === 'TEXTAREA' || t.isContentEditable)) return;
					keyBuf.push(e.key.toLowerCase());
					if (keyBuf.length > konami.length) keyBuf = keyBuf.slice(-konami.length);
					if (keyBuf.slice(-4).join('') === 'boss' || keyBuf.join(',') === konami.join(',')) {
						keyBuf = [];
						roar();
					}
				});

				// --- Feeding: visitors toss Boss a chop; he chomps and his belly grows ---
				const feedBtn = greeter.querySelector<HTMLButtonElement>('[data-feed]');
				if (feedBtn) {
					let meals = 0;
					let feeding = false;
					let digestTimer: ReturnType<typeof setTimeout>;

					const yummies = ['Chomp! Tanks ya! 😋', 'Mmm… sweet meat! 🤤', 'Whew… belly FULL! 🫃'];

					// Little brown crumbs sprayed from the mouth on each chomp.
					const crumbs = (x: number, y: number) => {
						const shades = ['#8a5a33', '#6f4526', '#a3703f'];
						for (let i = 0; i < 6; i++) {
							const bit = document.createElement('div');
							bit.className = 'confetti-bit';
							bit.style.background = shades[i % shades.length];
							bit.style.left = x + 'px';
							bit.style.top = y + 'px';
							bit.style.width = bit.style.height = '5px';
							document.body.appendChild(bit);
							gsap.set(bit, { xPercent: -50, yPercent: -50 });
							gsap.to(bit, {
								x: (Math.random() - 0.5) * 60,
								y: 30 + Math.random() * 40,
								rotation: Math.random() * 360,
								opacity: 0,
								duration: 0.6 + Math.random() * 0.3,
								ease: 'power1.in',
								onComplete: () => bit.remove(),
							});
						}
					};

					const setBelly = () => {
						if (!belly) return;
						const props = { scale: 1 + meals * 0.13, svgOrigin: '21 36' };
						if (reduced) gsap.set(belly, props);
						else gsap.to(belly, { ...props, duration: 0.45, ease: 'back.out(2)' });
					};

					const finishMeal = () => {
						greeter.classList.remove('eating');
						greeter.classList.add('happy');
						feedBtn.disabled = false;
						setTimeout(() => greeter.classList.remove('happy'), 1600);
						meals++;
						setBelly();
						bubble.textContent = "Thanks! Back to building.";
						showBubble();
						feeding = false;
						clearTimeout(digestTimer);
						// Digestion slowly empties the belly so Boss can chop again.
						digestTimer = setTimeout(() => {
							meals = 0;
							setBelly();
						}, 30000);
						calmTimer = setTimeout(() => {
							calmDown();
							hideBubble();
						}, 4500);
					};

					feedBtn.addEventListener('click', () => {
						if (feeding) return;
						clearTimeout(calmTimer);

						// Belly already full — Boss politely refuses.
						if (meals >= 3) {
							wake();
							bubble.textContent = "No more, tank ya — I'm FULL oo! 🫃";
							showBubble();
							if (!reduced) {
								gsap.fromTo(
									trex,
									{ rotation: -5 },
									{
										rotation: 5,
										duration: 0.09,
										repeat: 5,
										yoyo: true,
										ease: 'power1.inOut',
										onComplete: () => gsap.to(trex, { rotation: 0, duration: 0.15 }),
									}
								);
							}
							calmTimer = setTimeout(() => {
								calmDown();
								hideBubble();
							}, 3500);
							return;
						}

						// Food fixes everything: anger resets and sleepy Boss wakes to eat.
						calmDown();
						wake();
						feeding = true;
						feedBtn.disabled = true;
						greeter.classList.remove('happy');
						greeter.classList.add('eating');

						if (reduced) {
							finishMeal();
							return;
						}

						// A chop arcs from the button into Boss's mouth, then he chews.
						const food = document.createElement('div');
						food.className = 'food-bit';
						const foodArt = feedBtn.querySelector('[data-food-art]');
						if (foodArt) food.appendChild(foodArt.cloneNode(true));
						document.body.appendChild(food);
						const from = feedBtn.getBoundingClientRect();
						const rect = trex.getBoundingClientRect();
						const mouthX = rect.left + rect.width * 0.5;
						const mouthY = rect.top + rect.height * 0.42;
						gsap.set(food, {
							x: from.left + from.width / 2,
							y: from.top + from.height / 2,
							xPercent: -50,
							yPercent: -50,
							scale: 0.5,
							rotation: -25,
						});
						gsap.to(food, {
							keyframes: [
								{ scale: 1.15, duration: 0.16, ease: 'back.out(3)' },
								{
									x: (from.left + mouthX) / 2,
									y: Math.min(from.top, mouthY) - 48,
									rotation: 60,
									duration: 0.28,
									ease: 'power2.out',
								},
								{ x: mouthX, y: mouthY, scale: 0.7, rotation: 140, duration: 0.22, ease: 'power2.in' },
							],
							onComplete: () => {
								food.remove();
								crumbs(mouthX, mouthY);
								// Chomp-chomp: quick bites, then settle back down.
								gsap.fromTo(
									trex,
									{ scale: 1.07, transformOrigin: '50% 100%' },
									{
										scale: 0.95,
										duration: 0.09,
										repeat: 3,
										yoyo: true,
										ease: 'power1.inOut',
										onComplete: () => gsap.to(trex, { scale: 1, duration: 0.3, ease: 'back.out(3)', onComplete: finishMeal }),
									}
								);

							},
						});
					});
				}

			if (reduced) {
				gsap.set(trex, { opacity: 1, y: 0 });
				gsap.set(bubble, { opacity: 1, scale: 1, transformOrigin: '22% 100%' });
				gsap.set('[data-feed]', { opacity: 1 });
			} else {
				gsap.set(trex, { y: 70, opacity: 0 });
				gsap.set(bubble, { scale: 0, opacity: 0, transformOrigin: '22% 100%' });

				gsap
					.timeline({ delay: 0.8 })
					.to(trex, { y: 0, opacity: 1, duration: 0.7, ease: 'back.out(1.7)' })
					.to(bubble, { scale: 1, opacity: 1, duration: 0.5, ease: 'back.out(2)' }, '-=0.15')
					.to('[data-feed]', { opacity: 1, duration: 0.35 }, '-=0.2')
					.to(
						trex,
						isNight
							? { scale: 1.045, transformOrigin: '50% 100%', duration: 2.4, ease: 'sine.inOut', repeat: -1, yoyo: true }
							: { y: -6, duration: 1.1, ease: 'sine.inOut', repeat: -1, yoyo: true },
						'+=0.15'
					);

				// Tuck the greeting away after a few seconds (only if not mid-poke).
				gsap.to(bubble, {
					scale: 0,
					opacity: 0,
					duration: 0.4,
					ease: 'back.in(2)',
					delay: 5,
					overwrite: 'auto',
				});
			}
		}
	}

</script>
