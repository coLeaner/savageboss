---
import Layout from '../layouts/Layout.astro';
import Intro from '../components/Intro.astro';
import Skills from '../components/Skills.astro';
import Work from '../components/Work.astro';
import OffScreen from '../components/OffScreen.astro';
import Hero from '../components/Hero.astro';
import Trex from '../components/Trex.astro';
import FontSwitcher from '../components/FontSwitcher.astro';
---

<Layout>
	<main class="shell">
		<div class="col">
			<Intro />
			<Skills />
			<Work />
		</div>
		<!-- Polaroid row breaks out wider than the reading column -->
		<OffScreen />
		<Hero />
		<FontSwitcher />
	</main>
	<Trex />
</Layout>

<style>
	.shell {
		padding: 0 var(--gutter);
	}

	.col {
		max-width: var(--content);
		margin: 0 auto;
	}
</style>

<script>
	import { gsap } from 'gsap';
	import { ScrollTrigger } from 'gsap/ScrollTrigger';
	import { SplitText } from 'gsap/SplitText';
	import { MotionPathPlugin } from 'gsap/MotionPathPlugin';

	const reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

	if (!reduced) {
		gsap.registerPlugin(ScrollTrigger, SplitText, MotionPathPlugin);

		// Wait for the variable font so SplitText measures line breaks correctly.
		const ready = (document as any).fonts?.ready ?? Promise.resolve();

		ready.then(() => {
			const ease = 'power3.out';

			// --- Intro: name + paragraphs reveal on load ---
			const intro = gsap.timeline({ defaults: { ease } });

			// Bottom hero highlight boxes wipe in left→right when scrolled into view.
			const tags = gsap.utils.toArray<HTMLElement>('[data-tag]');
			if (tags.length) {
				gsap.to(tags, {
					clipPath: 'inset(0 0% 0 0)',
					duration: 0.9,
					ease: 'power4.out',
					stagger: 0.16,
					scrollTrigger: { trigger: '.hero-section', start: 'top 82%' },
				});
				// Playful tilt on hover.
				tags.forEach((tag, i) => {
					tag.addEventListener('mouseenter', () =>
						gsap.to(tag, {
							scale: 1.04,
							rotate: i === 0 ? -2.5 : 2.5,
							duration: 0.4,
							ease: 'power2.out',
						})
					);
					tag.addEventListener('mouseleave', () =>
						gsap.to(tag, {
							scale: 1,
							rotate: 0,
							duration: 0.6,
							ease: 'elastic.out(1, 0.5)',
						})
					);
				});
			}

			gsap.utils.toArray<HTMLElement>('[data-anim="fade"]').forEach((el) => {
				intro.to(el, { opacity: 1, y: 0, duration: 0.7 }, '<0.15');
				gsap.set(el, { y: 12 });
			});

			gsap.utils.toArray<HTMLElement>('[data-anim="lines"]').forEach((el) => {
				const split = new SplitText(el, { type: 'lines', mask: 'lines' });
				gsap.set(el, { opacity: 1 });
				intro.from(
					split.lines,
					{ yPercent: 100, opacity: 0, duration: 0.9, stagger: 0.08 },
					'<0.1'
				);
			});

			// --- Skills grid: staggered entrance on scroll ---
			const cards = gsap.utils.toArray<HTMLElement>('[data-anim="cards"]');
			if (cards.length) {
				gsap.fromTo(
					cards,
					{ opacity: 0, y: 24 },
					{
						opacity: 1,
						y: 0,
						duration: 0.6,
						ease,
						stagger: { each: 0.05, from: 'start' },
						scrollTrigger: { trigger: '.grid', start: 'top 85%' },
					}
				);
			}

			// --- Skills chips: gentle lift on hover ---
			cards.forEach((card) => {
				card.addEventListener('mouseenter', () =>
					gsap.to(card, { y: -5, duration: 0.35, ease: 'power3.out' })
				);
				card.addEventListener('mouseleave', () =>
					gsap.to(card, { y: 0, duration: 0.5, ease: 'power3.out' })
				);
			});

			// --- Work rows: fade + slide up on scroll ---
			gsap.utils.toArray<HTMLElement>('[data-anim="row"]').forEach((row) => {
				gsap.fromTo(
					row,
					{ opacity: 0, y: 22 },
					{
						opacity: 1,
						y: 0,
						duration: 0.7,
						ease,
						scrollTrigger: { trigger: row, start: 'top 88%' },
					}
				);
			});

			// --- "Say hi" links: brush stays visible, re-strokes + lifts on hover ---
			gsap.utils.toArray<HTMLElement>('.brushlink').forEach((link) => {
				link.addEventListener('mouseenter', () => {
					gsap.fromTo(
						link,
						{ '--paint': 0 },
						{ '--paint': 1, duration: 0.45, ease: 'power2.out', overwrite: 'auto' }
					);
					gsap.to(link, { y: -2, duration: 0.35, ease: 'power2.out' });
				});
				link.addEventListener('mouseleave', () =>
					gsap.to(link, { '--paint': 1, y: 0, duration: 0.25, ease: 'power2.in' })
				);
			});

			// --- Work rows: GSAP slide on hover (color handled by CSS) ---
			gsap.utils.toArray<HTMLElement>('.rowline').forEach((row) => {
				const title = row.querySelector<HTMLElement>('.title');
				const cat = row.querySelector<HTMLElement>('.category');
				if (!title) return;
				const hover = 'power3.out';
				row.addEventListener('mouseenter', () => {
					gsap.to(title, { x: 10, duration: 0.4, ease: hover });
					if (cat) gsap.to(cat, { x: -4, duration: 0.4, ease: hover });
				});
				row.addEventListener('mouseleave', () => {
					gsap.to(title, { x: 0, duration: 0.45, ease: hover });
					if (cat) gsap.to(cat, { x: 0, duration: 0.45, ease: hover });
				});
			});

			// --- Polaroids: start stacked/tilted, then fan out on scroll ---
			const fan = document.querySelector<HTMLElement>('[data-fan]');
			const polaroids = gsap.utils.toArray<HTMLElement>('[data-polaroid]');
			if (fan && polaroids.length) {
				gsap.set(fan, { opacity: 1 });
				const mid = (polaroids.length - 1) / 2;
				// Spread the whole fan across a fixed ~34° arc regardless of count.
				const step = polaroids.length > 1 ? 34 / (polaroids.length - 1) : 0;

				polaroids.forEach((card, i) => {
					const offset = i - mid;
					gsap.set(card, {
						rotate: 0,
						x: -offset * 45,
						y: 40,
						opacity: 0,
						transformOrigin: 'bottom center',
					});
				});

				gsap.to(polaroids, {
					rotate: (i) => (i - mid) * step,
					y: (i) => Math.abs(i - mid) * 6,
					x: 0,
					opacity: 1,
					duration: 1,
					ease: 'power3.out',
					stagger: 0.07,
					scrollTrigger: { trigger: fan, start: 'top 82%' },
				});

				// Hover label pill: pop up above each polaroid.
				polaroids.forEach((card) => {
					const tip = card.querySelector<HTMLElement>('.tip');
					if (!tip) return;
					const full = tip.textContent ?? '';
					let typeTimer: ReturnType<typeof setInterval>;
					gsap.set(tip, {
						y: 12,
						scale: 0.9,
						opacity: 0,
						transformOrigin: 'left bottom',
					});

					const typewrite = () => {
						clearInterval(typeTimer);
						let i = 0;
						tip.textContent = '';
						typeTimer = setInterval(() => {
							i++;
							tip.textContent = full.slice(0, i) + (i < full.length ? '|' : '');
							if (i >= full.length) clearInterval(typeTimer);
						}, 45);
					};

					card.addEventListener('mouseenter', () => {
						gsap.to(tip, {
							y: 0,
							scale: 1,
							opacity: 1,
							duration: 0.35,
							ease: 'back.out(2.2)',
						});
						typewrite();
					});
					card.addEventListener('mouseleave', () => {
						clearInterval(typeTimer);
						gsap.to(tip, {
							y: 12,
							scale: 0.9,
							opacity: 0,
							duration: 0.25,
							ease: 'power2.in',
							onComplete: () => (tip.textContent = full),
						});
					});
				});
			}

			// --- MotionPath: a paper plane orbits around ALL the photos ---
			const flightSvg = document.querySelector('.flight');
			const plane = document.querySelector('#plane');
			const pathEl = document.querySelector('#flightPath');
			let flightTween = null;

			const buildFlight = () => {
				if (!flightSvg || !plane || !pathEl || !polaroids.length) return;
				const W = flightSvg.clientWidth;
				const H = flightSvg.clientHeight;
				if (!W || !H) return;
				flightSvg.setAttribute('viewBox', `0 0 ${W} ${H}`);
				// Measure the photo cluster via layout boxes (ignores GSAP transforms).
				let minX = Infinity, maxX = -Infinity, minY = Infinity, maxY = -Infinity;
				polaroids.forEach((c) => {
					minX = Math.min(minX, c.offsetLeft);
					maxX = Math.max(maxX, c.offsetLeft + c.offsetWidth);
					minY = Math.min(minY, c.offsetTop);
					maxY = Math.max(maxY, c.offsetTop + c.offsetHeight);
				});
				const cx = (minX + maxX) / 2;
				const cy = (minY + maxY) / 2;
				const rx = (maxX - minX) / 2 + 28;
				const ry = (maxY - minY) / 2 + 22;
				const k = 0.5523;
				const ox = rx * k;
				const oy = ry * k;
				const d =
					`M ${cx - rx},${cy} ` +
					`C ${cx - rx},${cy - oy} ${cx - ox},${cy - ry} ${cx},${cy - ry} ` +
					`C ${cx + ox},${cy - ry} ${cx + rx},${cy - oy} ${cx + rx},${cy} ` +
					`C ${cx + rx},${cy + oy} ${cx + ox},${cy + ry} ${cx},${cy + ry} ` +
					`C ${cx - ox},${cy + ry} ${cx - rx},${cy + oy} ${cx - rx},${cy} Z`;
				pathEl.setAttribute('d', d);
				if (flightTween) flightTween.kill();
				gsap.set(plane, { opacity: 0 });
				flightTween = gsap.to(plane, {
					duration: 20,
					repeat: -1,
					ease: 'none',
					motionPath: { path: pathEl, align: pathEl, alignOrigin: [0.5, 0.5], autoRotate: true },
				});
				gsap.to(plane, { opacity: 1, duration: 0.6, delay: 0.1, ease: 'power1.out' });
			};

			buildFlight();
			let flightResize;
			window.addEventListener('resize', () => {
				clearTimeout(flightResize);
				flightResize = setTimeout(buildFlight, 200);
			});

			ScrollTrigger.refresh();
		});
	}

	// --- T-Rex greeter: greets, and gets angry if you keep poking it ---
	const greeter = document.querySelector<HTMLElement>('[data-greeter]');
	if (greeter) {
		const trex = greeter.querySelector<HTMLElement>('.trex');
		const bubble = greeter.querySelector<HTMLElement>('[data-bubble]');

		if (trex && bubble) {
			const friendly = "Hi, I'm Boss";
			const pokes = ['Hey!', 'Quit it.', "I'm warning you…"];
			const angry = 'APEX PREDATOR! 🦖';
			let clicks = 0;
			let calmTimer: ReturnType<typeof setTimeout>;

			// Colour shifts one step warmer on every poke, up to angry red.
			const skins = trex.querySelectorAll<SVGElement>('.skin');
			const belly = trex.querySelector<SVGElement>('.belly');
			const spikes = trex.querySelectorAll<SVGElement>('.spike');
			const levels = [
				null, // 0: default green (from CSS)
				{ s: '#8fbf3f', b: '#c3e07f', k: '#78a52f' }, // lime
				{ s: '#e0b52e', b: '#f2d98a', k: '#c19620' }, // amber
				{ s: '#e8792a', b: '#f4b184', k: '#c25f18' }, // orange
				{ s: '#d83a2c', b: '#f2988c', k: '#b32819' }, // angry red
			];
			const paint = (level: number) => {
				const c = levels[level];
				skins.forEach((e) => (e.style.fill = c ? c.s : ''));
				if (belly) belly.style.fill = c ? c.b : '';
				spikes.forEach((e) => (e.style.fill = c ? c.k : ''));
			};

			const showBubble = () =>
				reduced
					? gsap.set(bubble, { scale: 1, opacity: 1 })
					: gsap.to(bubble, { scale: 1, opacity: 1, duration: 0.35, ease: 'back.out(2)', overwrite: true });
			const hideBubble = () =>
				reduced
					? gsap.set(bubble, { scale: 0, opacity: 0 })
					: gsap.to(bubble, { scale: 0, opacity: 0, duration: 0.3, ease: 'back.in(2)', overwrite: true });

			const calmDown = () => {
				clicks = 0;
				greeter.classList.remove('angry');
				trex.classList.remove('angry');
				paint(0);
				bubble.textContent = friendly;
			};

			trex.addEventListener('click', () => {
				clicks++;
				clearTimeout(calmTimer);
				paint(Math.min(clicks, 4));

				if (clicks >= 4) {
					greeter.classList.add('angry');
					trex.classList.add('angry');
					bubble.textContent = angry;
					if (!reduced) {
						gsap.fromTo(
							trex,
							{ rotation: -9 },
							{
								rotation: 9,
								duration: 0.07,
								repeat: 7,
								yoyo: true,
								ease: 'power1.inOut',
								onComplete: () => gsap.to(trex, { rotation: 0, duration: 0.15 }),
							}
						);
					}
				} else {
					bubble.textContent = pokes[Math.min(clicks - 1, pokes.length - 1)];
					if (!reduced) gsap.fromTo(trex, { scale: 0.88 }, { scale: 1, duration: 0.4, ease: 'back.out(3)' });
				}

				showBubble();
				// Boss cools off after you leave him alone for a bit.
				calmTimer = setTimeout(() => {
					calmDown();
					hideBubble();
				}, 4500);
			});

			// Bubble reappears on hover, tucks away on leave.
			greeter.addEventListener('mouseenter', showBubble);
			greeter.addEventListener('mouseleave', hideBubble);

			if (reduced) {
				gsap.set(trex, { opacity: 1, y: 0 });
				gsap.set(bubble, { opacity: 1, scale: 1, transformOrigin: '22% 100%' });
			} else {
				gsap.set(trex, { y: 70, opacity: 0 });
				gsap.set(bubble, { scale: 0, opacity: 0, transformOrigin: '22% 100%' });

				gsap
					.timeline({ delay: 0.8 })
					.to(trex, { y: 0, opacity: 1, duration: 0.7, ease: 'back.out(1.7)' })
					.to(bubble, { scale: 1, opacity: 1, duration: 0.5, ease: 'back.out(2)' }, '-=0.15')
					.to(trex, { y: -6, duration: 1.1, ease: 'sine.inOut', repeat: -1, yoyo: true }, '+=0.15');

				// Tuck the greeting away after a few seconds (only if not mid-poke).
				gsap.to(bubble, {
					scale: 0,
					opacity: 0,
					duration: 0.4,
					ease: 'back.in(2)',
					delay: 5,
					overwrite: 'auto',
				});
			}
		}
	}

	// --- Click-to-copy email (runs regardless of motion preference) ---
	const copyEl = document.getElementById('copy-email');
	if (copyEl) {
		const label = copyEl.querySelector<HTMLElement>('.label');
		const email = copyEl.getAttribute('data-email') || '';
		let busy = false;

		async function copyText(text: string) {
			try {
				await navigator.clipboard.writeText(text);
			} catch {
				const ta = document.createElement('textarea');
				ta.value = text;
				ta.style.position = 'fixed';
				ta.style.opacity = '0';
				document.body.appendChild(ta);
				ta.select();
				try {
					document.execCommand('copy');
				} catch {}
				ta.remove();
			}
		}

		copyEl.addEventListener('click', async (e) => {
			e.preventDefault();
			if (busy || !label) return;
			busy = true;
			await copyText(email);

			if (reduced) {
				label.textContent = 'Copied!';
				setTimeout(() => {
					label.textContent = 'email';
					busy = false;
				}, 1400);
				return;
			}

			// "email" slides up out, "Copied!" slides up in, then reverses back.
			gsap
				.timeline({ onComplete: () => (busy = false) })
				.to(label, {
					yPercent: -120,
					opacity: 0,
					duration: 0.22,
					ease: 'power2.in',
					onComplete: () => (label.textContent = 'Copied!'),
				})
				.set(label, { yPercent: 120 })
				.to(label, { yPercent: 0, opacity: 1, duration: 0.32, ease: 'power2.out' })
				.to(label, {
					yPercent: -120,
					opacity: 0,
					duration: 0.22,
					ease: 'power2.in',
					delay: 1.2,
					onComplete: () => (label.textContent = 'email'),
				})
				.set(label, { yPercent: 120 })
				.to(label, { yPercent: 0, opacity: 1, duration: 0.32, ease: 'power2.out' });
		});
	}
</script>
